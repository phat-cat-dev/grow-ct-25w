{
  "_type": "config",
  "_defaultLanguage": "en",
  "_defaultDirection": "ltr",
  "_questionWeight": 1,

  "_theme": "grow-ct",
  "_menu": "adapt-contrib-boxMenu",

  "_grow": {
    "_disableMotion": false
  },

  "_accessibility": {
    "_isEnabled": true,
    "_isSkipNavigationEnabled": true,
    "_ariaLevels": {
      "_menu": 1, "_menuGroup": "@menu+1", "_menuItem": "@menu+1",
      "_page": 1, "_article": "@page+1", "_block": "@article+1",
      "_component": "@block+1", "_componentItem": "@component+1", "_notify": 1
    },
    "_options": {
      "_isPrefersReducedMotionEnabled": true,
      "_isFocusOutlineKeyboardOnlyEnabled": true
    }
  },

  "screenSize": { "small": 520, "medium": 760, "large": 1024 },

  "_fixedWidth": "90rem",
  "_drawer": { "_position": "auto" }
}
