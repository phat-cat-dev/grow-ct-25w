{{! ============================================================================
    grow-base OVERRIDE of core article.hbs
    Overrides core by filename (theme is registered last). Keeps every core hook
    — .article__inner, .js-heading, .block__container (where blocks mount) — and
    ADDS one new structural section, .article__frontmatter, generated from
    the authored field _grow._frontmatter, exactly the way title/body are.
    ============================================================================ }}
{{import_globals}}

<div class="article__inner">

  {{#any displayTitle body instruction}}
  <div class="article__header">
    <div class="article__header-inner">

      {{#if priorityLabel}}
      <div class="article__priority {{_priorityClass}}">
        {{#if _priorityIconClass}}
        <span class="icon {{_priorityIconClass}}" aria-hidden="true"></span>
        {{/if}}
        <div class="article__priority-label">
          {{{compile priorityLabel}}}
        </div>
      </div>
      {{/if}}

      {{#if displayTitle}}
      <div class="article__title">
        <div class="article__title-inner js-heading"></div>
      </div>
      {{/if}}

      {{#if body}}
      <div class="article__body">
        <div class="article__body-inner">
          {{{compile body}}}
        </div>
      </div>
      {{/if}}

      {{#if instruction}}
      <div class="article__instruction">
        <div class="article__instruction-inner">
          {{{compile instruction}}}
        </div>
      </div>
      {{/if}}

    </div>
  </div>
  {{/any}}

  {{! ---- grow frontmatter (shared partial; visible when _display) ---- }}
  <div class="article__frontmatter">
    {{> _grow-frontmatter _grow._frontmatter role="phase"}}
  </div>

  <div class="block__container">
    {{!-- Blocks render here (core hook preserved) --}}
  </div>

</div>
