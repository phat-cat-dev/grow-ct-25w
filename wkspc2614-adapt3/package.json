{
  "name": "adapt_framework",
  "version": "5.56.2",
  "description": "Adapt Learning output framework",
  "repository": {
    "type": "git",
    "url": "git://github.com/adaptlearning/adapt_framework.git"
  },
  "scripts": {
    "preinstall": "node gitmodules.js",
    "lint": "node node_modules/eslint/bin/eslint.js ./",
    "test": "node ./test.js",
    "adapt-install": "adapt install && node scripts/apply-vendor-patches.js",
    "pk-bundle": "node tools/bundle-project-knowledge.js",
    "course-export": "node tools/course-export.js",
    "course-script-md": "node tools/course-script-md.js",
    "course-css-export": "node tools/course-css-export.js",
    "course-script-prompts": "node tools/course-script-prompts-md.js",
    "template-prompts": "node tools/template-field-map.js --out exports/template-prompts.md",
    "component-reference": "node tools/adapt-ab/ab-component-reference.js",
    "course-script-import": "node tools/course-script-import.js",
    "component-map": "node tools/component-map.js",
    "viewer": "node _workspace/grunt-menu/viewer.js",
    "menu": "node _workspace/grunt-menu/viewer.js",
    "help": "node _workspace/grunt-menu/viewer.js help",
    "course:build": "node _workspace/grunt-menu/viewer.js rebuild",
    "references": "node tools/export-references.js",
    "references:import": "node tools/export-references.js --import",
    "theme-css": "node tools/adapt-ab/ab-theme-css.js",
    "theme-computed": "node tools/adapt-ab/ab-theme-computed.js",
    "theme-export": "node tools/adapt-ab/ab-theme-css.js && node tools/adapt-ab/ab-theme-computed.js"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/adaptlearning/adapt_framework/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "dependencies": {
    "@babel/core": "^7.21.4",
    "@babel/plugin-transform-react-jsx": "^7.21.0",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-react": "^7.18.6",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/backbone": "^1.4.14",
    "@types/jquery": "^3.5.16",
    "adapt": "^0.3.0",
    "adapt-migrations": "^1.0.0",
    "async": "^3.2.2",
    "babel-plugin-transform-amd-to-es6": "^0.6.1",
    "babel-plugin-transform-react-templates": "^0.1.0",
    "chalk": "^2.4.1",
    "columnify": "^1.5.4",
    "csv": "^6.6.4",
    "fast-xml-parser": "^5.11.2",
    "fs-extra": "^8.1.0",
    "globs": "^0.1.4",
    "grunt": "^1.6.3",
    "grunt-concurrent": "^3.0.0",
    "grunt-contrib-clean": "^2.0.0",
    "grunt-contrib-connect": "^2.0.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-watch": "^0.4.4",
    "grunt-file-order": "^1.0.0",
    "grunt-json-minify": "^1.1.0",
    "grunt-jsonlint": "^2.1.5",
    "grunt-newer": "^1.3.0",
    "grunt-replace": "^2.0.2",
    "grunt-terser": "^2.0.0",
    "handlebars": "^4.7.9",
    "iconv-lite": "^0.6.3",
    "jit-grunt": "^0.10.0",
    "jschardet": "^1.6.0",
    "jshint-stylish": "^2.2.1",
    "less": "^3.9.0",
    "load-grunt-config": "^3.0.2",
    "lodash": "^4.18.1",
    "nsdeclare": "^0.1.0",
    "rollup": "^2.80.0",
    "semver": "^7.6.0",
    "time-grunt": "^2.0.0",
    "underscore": "^1.13.8",
    "underscore-deep-extend": "^1.1.5"
  },
  "release": {
    "extends": "@adaptlearning/semantic-release-config"
  },
  "devDependencies": {
    "@adaptlearning/semantic-release-config": "^1.0.2",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/mcp": "^0.0.78",
    "cypress": "^16.2.0",
    "eslint": "^8.49.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^16.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-requirejs": "^4.0.1",
    "jest": "^30.5.2",
    "jest-environment-adapt": "^1.0.0",
    "playwright": "^1.61.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "wait-on": "^8.0.3"
  },
  "optionalDependencies": {
    "imagemin": "^7.0.1",
    "imagemin-jpegtran": "^7.0.0",
    "imagemin-pngquant": "^5.0.1",
    "imagemin-svgo": "^12.0.0"
  }
}
