{
  "section": "icons",
  "schemaVersion": "0.2.0",
  "note": "Icon-set packs + per-glyph tokens. A pack = a named group of Google Material Symbol ligatures, self-hosted as an offline subset (SCORM ships offline, never runtime-linked to Google). Pack token: --ab-base-<pack>-iconset (the member list). Per-glyph token (Abbott 12 Oct 2026, option c): --ab-base-icon-<name>-<scheme>-<style>, LIGATURE-keyed (value = the Material Symbol ligature the font renders via content:), NOT codepoint \u2014 the repo carries no codepoint data and the CSS already renders by ligature; <style> is the self-hosted cut (outlined = FILL 0). Themeable: a user theme may swap a glyph's ligature. These are the L3 templates + L4 default packs; worked impl ab-icons.less (the .ab.icon-<name> font/SVG rules) is wired to consume them as a follow-on. The SVG-mask variants stay as inline data-URIs (not ligature-expressible).",
  "seeds": {
    "academic-practice-iconset": {
      "kind": "symbol-list",
      "default": [
        "starting",
        "progressing",
        "graduating",
        "wellbeing",
        "learning",
        "assessment",
        "feedback",
        "integrity",
        "finding",
        "studying",
        "referencing",
        "researching",
        "writing",
        "presenting",
        "reflecting",
        "revising-exams",
        "criticality",
        "creativity",
        "international",
        "ai-technology",
        "signpost"
      ],
      "themeable": true,
      "template": {
        "label": "Academic-practice icon pack",
        "input": "iconset",
        "presets": [
          "standard",
          "full"
        ]
      }
    },
    "cite-source-iconset": {
      "kind": "symbol-list",
      "default": [
        "book",
        "article",
        "language_us",
        "web",
        "movie",
        "podcast"
      ],
      "themeable": true,
      "template": {
        "label": "Cite-source icon pack",
        "input": "iconset",
        "presets": [
          "standard",
          "full"
        ]
      }
    },
    "elearn-ui-iconset": {
      "kind": "symbol-list",
      "default": [
        "quiz"
      ],
      "themeable": true,
      "template": {
        "label": "Elearn-UI icon pack",
        "input": "iconset",
        "presets": [
          "standard"
        ]
      }
    }
  },
