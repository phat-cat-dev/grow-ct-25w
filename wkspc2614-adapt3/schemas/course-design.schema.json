{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://excelling.cardiffmet/schemas/course-design.schema.json",
  "title": "course-design.json \u2014 per-course manifest of decisions",
  "description": "Declares what the course IS \u2014 facet set, archetype instantiations, slot choices, every gate outcome with provenance and grounding \u2014 never what it CONTAINS. No content bodies, no structure JSON (S1-D5). Written at phase close. Ledger is derived from gate records, not stored. Gate history is append-only; dimension 5 settled 26 Aug 2026 (S2): records + sweepEvents together are the full history (gate model \u00a75). PROVISIONAL lifted.",
  "type": "object",
  "required": [
    "schemaVersion",
    "courseId",
    "slug",
    "facetSet",
    "kbVersions",
    "gates",
    "phases",
    "instantiations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "courseId": {
      "type": "string",
      "description": "CONVENTION (retro-fill, 26 Aug 2026): courseId semantics were undefined at drafting; pilot adopts courseId = slug until a distinct id scheme is needed."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "status": {
      "enum": [
        "in-development",
        "production"
      ],
      "description": "Lifecycle status, migrated here from lesson-registry (S1-D6). Registry becomes a generated view; latestTrackingId lives in the tooling-owned build-state file, NOT here. status 'production' means the course is published: all gate fields are then locked, and a reopen may change only the decidedValue paths it unlocks (field-locks-and-edit-mode.md)."
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the course was first published (status -> production) and thereby locked. Set by /publish; absent while in-development."
    },
    "facetSet": {
      "$ref": "common.schema.json#/$defs/facetSet"
    },
    "profile": {
      "enum": [
        "built-course-shape",
        "single-course",
        "pathway-distillation"
      ],
      "description": "Which gate-profiles.json profile this course's gate sequence follows. Absent means built-course-shape (the default, pre-existing shape all 45 courses were built under). Read by validate-design-schemas.py (NSK-1) to resolve which gates are in-scope for this course before checking cross-gate dependencies."
    },
    "kbVersions": {
      "type": "object",
      "description": "Store versions this design was conducted against. CONVENTION (retro-fill, 26 Aug 2026): 0.0.0 = design conducted before the store was populated (pre-population placeholder), used by the AW:Intro retro-fill; real versions from first populated release.",
      "required": [
        "design-kb"
      ],
      "properties": {
        "design-kb": {
          "$ref": "common.schema.json#/$defs/kbVersion"
        },
        "source-kb": {
          "$ref": "common.schema.json#/$defs/kbVersion"
        },
        "institutional-kb": {
          "$ref": "common.schema.json#/$defs/kbVersion"
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gateId",
          "records"
        ],
        "properties": {
          "gateId": {
            "type": "string",
            "pattern": "^(gates/|(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}_|[A-Za-z0-9-]+-(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}$)"
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "description": "Append-only. A reopened gate appends a superseding record; nothing is rewritten. Current state = last record.",
            "items": {
              "type": "object",
              "required": [
                "seq",
                "state",
                "timestamp"
              ],
              "properties": {
                "seq": {
                  "type": "integer",
                  "minimum": 1
                },
                "state": {
                  "$ref": "common.schema.json#/$defs/gateState"
                },
                "provenance": {
                  "$ref": "common.schema.json#/$defs/provenance"
                },
                "decidedValue": {
                  "description": "The decision content itself \u2014 any JSON shape the gate needs (list of lessons, a slot choice, a facet set). Decisions, not bodies.",
                  "type": [
                    "string",
                    "object",
                    "array",
                    "boolean",
                    "number"
                  ]
                },
                "originalProposal": {
                  "description": "REQUIRED when provenance=human-amended: the AI's proposal before amendment.",
                  "type": [
                    "string",
                    "object",
                    "array",
                    "boolean",
                    "number"
                  ]
                },
                "grounding": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/citation"
                  },
                  "description": "What the proposal rested on \u2014 design-kb, source-kb (S1-D2), prose, prior gate outcomes."
                },
                "groundingGaps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["store", "lookup", "wouldHaveGrounded"],
                    "properties": {
                      "store": { "enum": ["source-kb", "institutional-kb"] },
                      "lookup": {
                        "type": "string",
                        "description": "The entry sought, e.g. module/ACW4001, qaa/criminology"
                      },
                      "wouldHaveGrounded": {
                        "type": "string",
                        "description": "One sentence: what a hit would have supplied or derived."
                      },
                      "gapKind": {
                        "enum": ["no-matching-entry", "store-unpopulated"],
                        "description": "Ruled 17 Sep 2026: distinguishes a store that was consulted and had nothing matching (no-matching-entry) from a store that has no data file at all yet (store-unpopulated), e.g. PR-S-26. Optional; absence keeps today's meaning."
                      }
                    },
                    "additionalProperties": false
                  },
                  "description": "S3-D3 (amendment A5): declared no-source-match gaps. An honest record of sources consulted but absent; feeds the sourcing task list; the 5.13 lint reports gaps, never refuses on them; source arrival is recorded, not mechanised. Store enum deliberately excludes design-kb (a design-kb miss is a population state, not a sourcing gap) and course-design."
                },
                "confirmedAt": {
                  "enum": [
                    "gate",
                    "phase-close"
                  ],
                  "description": "Distinguishes confirmed-at-gate from bulk-blessing at phase close."
                },
                "deferReason": {
                  "type": "string"
                },
                "supersedes": {
                  "type": "integer",
                  "description": "seq of the record this one supersedes. Dimension 5 (26 Aug 2026): the reopen path - a confirmed invalidate verdict realises as a superseding record; the triggering sweepEvent carries the verdict trail and cites this record via resolution.supersededBy."
                },
                "unlocked": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Published-course edit-mode (field-locks-and-edit-mode.md): on a published course (status 'production') a reopen may change only these decidedValue dot-paths (e.g. 'check.items', 'outcomes'); every other field is carried forward verbatim from the superseded record, and the lint refuses any out-of-scope change. Absent on an original record and on reopens of an in-development course."
                },
                "alternativesConsidered": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "whyNot"
                    ],
                    "properties": {
                      "pattern": {
                        "type": "string"
                      },
                      "whyNot": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "description": "Alternatives considered and rejected at this gate; absent means none were recorded, not that none existed. 5.146/ALT-1 (adp-0222, RJ-0009): pattern is optional, not required - a gate with no activity pattern to name (e.g. CTX, A1) still names why an alternative was rejected via whyNot alone. ALT-1 settles when the field is kept; this is the separate schema-level fix 5.146 names, that every item previously had to name a pattern even where none existed."
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "sessionRef": {
                  "description": "An object distinguishing venue from a short description (SRF-1: object form only). Records written before this restriction may still be string-form on disk; this schema no longer accepts that form.",
                  "type": "object",
                  "required": [
                    "venue",
                    "description"
                  ],
                  "properties": {
                    "venue": {
                      "enum": [
                        "claude-ai-relay",
                        "claude-code-plan",
                        "claude-code"
                      ]
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "reconstruction": {
                  "type": "object",
                  "description": "AMENDMENT (retro-fill convention, human-confirmed 26 Aug 2026): present on reconstructed records. basis=documented: a dated record evidences decision AND mode; provenance used at face value. basis=inferred: artefact state proves the decision but the deciding exchange is unrecorded; provenance omitted, decidedValue from the artefact. Where neither settles the value, no closed record is written (gate stays pending).",
                  "required": [
                    "basis",
                    "evidence"
                  ],
                  "properties": {
                    "basis": {
                      "enum": [
                        "documented",
                        "inferred"
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "common.schema.json#/$defs/citation"
                      }
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "provenanceDisputed": {
                  "type": "object",
                  "description": "Records that a superseded record asserted a provenance word inconsistent with its gate's hardness. Distinct from reconstruction, which is for a record that never existed and whose provenance is legitimately absent.",
                  "required": [
                    "assertedValue",
                    "reason",
                    "evidence"
                  ],
                  "properties": {
                    "assertedValue": {
                      "type": "string",
                      "description": "The provenance word the superseded record carried."
                    },
                    "reason": {
                      "type": "string",
                      "description": "One sentence on why it is wrong."
                    },
                    "correctedValue": {
                      "type": "string",
                      "description": "The right word where the session log shows it; absent means unrecoverable."
                    },
                    "evidence": {
                      "type": "string",
                      "description": "What was consulted and what it showed or failed to show."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "provenance": {
                        "const": "human-amended"
                      }
                    },
                    "required": [
                      "provenance"
                    ]
                  },
                  "then": {
                    "required": [
                      "originalProposal"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "state": {
                        "const": "deferred"
                      }
                    },
                    "required": [
                      "state"
                    ]
                  },
                  "then": {
                    "required": [
                      "deferReason"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "state": {
                        "const": "closed"
                      }
                    },
                    "required": [
                      "state"
                    ]
                  },
                  "then": {
                    "allOf": [
                      {
                        "required": [
                          "decidedValue"
                        ]
                      },
                      {
                        "if": {
                          "anyOf": [
                            {
                              "properties": {
                                "reconstruction": {
                                  "properties": {
                                    "basis": {
                                      "const": "inferred"
                                    }
                                  },
                                  "required": [
                                    "basis"
                                  ]
                                }
                              },
                              "required": [
                                "reconstruction"
                              ]
                            },
                            {
                              "properties": {
                                "provenanceDisputed": {
                                  "type": "object",
                                  "not": {
                                    "required": [
                                      "correctedValue"
                                    ]
                                  }
                                }
                              },
                              "required": [
                                "provenanceDisputed"
                              ]
                            }
                          ]
                        },
                        "then": {},
                        "else": {
                          "required": [
                            "provenance"
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phaseId",
          "closedAt"
        ],
        "properties": {
          "phaseId": {
            "type": "string",
            "description": "A, B-L02, B-L03, S, W ..."
          },
          "closedAt": {
            "type": "string",
            "format": "date-time"
          },
          "bulkBlessing": {
            "type": "object",
            "description": "Events, not derivable \u2014 hence stored. The ledger itself is derived from gate records.",
            "properties": {
              "blessed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(gates/|(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}_|[A-Za-z0-9-]+-(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}$)"
                },
                "description": "Recorded as human-confirmed, confirmedAt=phase-close."
              },
              "stood": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(gates/|(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}_|[A-Za-z0-9-]+-(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}$)"
                },
                "description": "Ignored at sweep; stay ai-default-stood. For gates with defaultType fixed-value."
              },
              "proposalStood": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(gates/|(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}_|[A-Za-z0-9-]+-(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}$)"
                },
                "description": "GI-2 amendment: for gates with defaultType ai-proposal-stands where the AI's proposal stood on silence; stay ai-proposal-stood. Distinct from stood which is for fixed-value defaultType gates."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "instantiations": {
      "type": "array",
      "description": "Which archetype each page instantiates and how its slots were filled. Points at archetypes and palette by id+version; holds choices, never block JSON.",
      "items": {
        "type": "object",
        "required": [
          "pageKey",
          "pageType",
          "archetype"
        ],
        "properties": {
          "pageKey": {
            "type": "string",
            "description": "W-OPEN, C-PRE, L02, SUMM, C-POST, W-CLOSE ..."
          },
          "pageType": {
            "enum": [
              "wrapper-open",
              "c-pre",
              "lesson",
              "summative",
              "c-post",
              "wrapper-close"
            ]
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "archetype": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^skeletons/"
              },
              "version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "slotChoices": {
            "type": "array",
            "description": "Every kind: variable slot the archetype's blockSequence names must have an entry here recording which component filled it (SC-1, docs/project/open-decisions.md, Prompt 81).",
            "items": {
              "type": "object",
              "required": [
                "slotKey",
                "component"
              ],
              "properties": {
                "slotKey": {
                  "type": "string",
                  "description": "The archetype block key this fills."
                },
                "component": {
                  "type": "string",
                  "pattern": "^palette/"
                },
                "contextCoupling": {
                  "type": "object",
                  "required": [
                    "coupled"
                  ],
                  "properties": {
                    "coupled": {
                      "type": "boolean"
                    },
                    "variationType": {
                      "enum": [
                        "token-substitution",
                        "structured-fields",
                        "whole-prose"
                      ]
                    },
                    "tokenMode": {
                      "enum": [
                        "generic",
                        "cxp-fillable"
                      ],
                      "description": "Qualifier for variationType 'token-substitution' only: generic -> {{context}} fixed to 'your subject', pack cannot fill; cxp-fillable (default when absent) -> pack fills context.label, floor 'your subject'. Decided case by case at the gate that sets this slot's coupling."
                    },
                    "facetOverrides": {
                      "$ref": "common.schema.json#/$defs/facetSet",
                      "description": "Activity-floor tagging: this slot/activity's own facet set where it differs from the course's (S1-D3)."
                    }
                  },
                  "additionalProperties": false
                },
                "decidedByGate": {
                  "type": "string",
                  "pattern": "^(gates/|(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}_|[A-Za-z0-9-]+-(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}$)",
                  "description": "Which gate record carries this choice's provenance."
                }
              },
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string",
            "description": "AMENDMENT (retro-fill, 26 Aug 2026): free-text caveats \u2014 known conformance deviations, reconstruction gaps (e.g. a slot whose component is not recoverable from records). Added because reconstructed instantiations need somewhere honest to carry deviations the manifest would otherwise silently smooth."
          }
        },
        "additionalProperties": false
      }
    },
    "retroFill": {
      "type": "object",
      "description": "AMENDMENT (retro-fill convention, S1 close-out, human-confirmed 26 Aug 2026): present when this manifest was reconstructed from records after the fact rather than written at phase close. Per-record reconstruction quality lives in each gate record's reconstruction object.",
      "required": [
        "filledAt",
        "method"
      ],
      "properties": {
        "filledAt": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string"
        },
        "sessionRef": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "exemptions": {
      "type": "array",
      "description": "LCR-1 (docs/project/open-decisions.md, Prompt 143): human overrides of a lesson-level check. Each entry is one exemption; a check reads this array and passes the named lesson for the named check while still reporting the exemption on every run.",
      "items": {
        "type": "object",
        "required": [
          "lessonId",
          "check",
          "date",
          "reason"
        ],
        "properties": {
          "lessonId": {
            "type": "string"
          },
          "check": {
            "type": "string",
            "description": "The check id this exemption covers, e.g. OC-1, CO-1, BKS-1, CK-1, RP-1, CP-1h, LPG-1, PSR-1, PLR-1."
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Abbott's reason, in his words. LCR-1: an exemption with no reason is itself a fault."
          }
        },
        "additionalProperties": false
      }
    },
    "sweepEvents": {
      "type": "array",
      "description": "AMENDMENT (dimension 5, S2, 26 Aug 2026): append-only reopen-sweep events - the other half of the gate history. One event spans many gates, hence top-level, sibling to gates. Build-readiness is DERIVED, never stored: build-ready iff no entry has resolution.status=open; the 5.13 lint refuses on an unresolved event (manifest = build contract).",
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "timestamp",
          "trigger",
          "sweep"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^SW-[0-9]+$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "trigger": {
            "type": "object",
            "required": [
              "gate",
              "changeKind"
            ],
            "properties": {
              "gate": {
                "type": "string",
                "pattern": "^(gates/|(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}_|[A-Za-z0-9-]+-(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}$)"
              },
              "changeKind": {
                "enum": [
                  "amended",
                  "replaced",
                  "re-deferred",
                  "facet-added",
                  "facet-removed",
                  "facet-swapped"
                ],
                "description": "Recorded, not mechanised (dim 4). facet-* kinds are CTX-only and feed the tracer rule."
              },
              "oldRecordSeq": {
                "type": "integer"
              },
              "newRecordSeq": {
                "type": "integer"
              },
              "note": {
                "type": "string",
                "description": "The change in one human sentence."
              }
            },
            "additionalProperties": false
          },
          "sweep": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "gate",
                "recordSeq",
                "basis",
                "defaultVerdict",
                "disposition"
              ],
              "properties": {
                "gate": {
                  "type": "string",
                  "pattern": "^(gates/|(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}_|[A-Za-z0-9-]+-(ctx|crs|les|act|onb|cxs|wra|cxp)-[0-9]{2}$)"
                },
                "recordSeq": {
                  "type": "integer"
                },
                "basis": {
                  "description": "What put this record in the net: the static edge as {gate, dependencyClass}, or the string 'universal' for CTX-scope reopens (tracer citation goes in disposition/resolution notes).",
                  "type": [
                    "object",
                    "string"
                  ]
                },
                "defaultVerdict": {
                  "enum": [
                    "invalidate",
                    "flag-for-review",
                    "stand-with-warning"
                  ]
                },
                "disposition": {
                  "type": "object",
                  "required": [
                    "verdict",
                    "mode"
                  ],
                  "properties": {
                    "verdict": {
                      "enum": [
                        "invalidate",
                        "flag-for-review",
                        "stand-with-warning"
                      ]
                    },
                    "mode": {
                      "enum": [
                        "confirmed",
                        "amended",
                        "stood"
                      ],
                      "description": "Provenance pattern extended to sweep verdicts."
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "amended"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  "then": {
                    "required": [
                      "note"
                    ]
                  }
                },
                "resolution": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "description": "Absent for stand-with-warning; required for the other two verdicts (enforced below).",
                  "properties": {
                    "status": {
                      "enum": [
                        "open",
                        "resolved"
                      ]
                    },
                    "supersededBy": {
                      "type": "integer",
                      "description": "invalidate path: seq of the superseding record."
                    },
                    "flagResolution": {
                      "enum": [
                        "re-affirmed",
                        "escalated",
                        "demoted"
                      ]
                    },
                    "note": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "if": {
                "properties": {
                  "disposition": {
                    "properties": {
                      "verdict": {
                        "enum": [
                          "invalidate",
                          "flag-for-review"
                        ]
                      }
                    },
                    "required": [
                      "verdict"
                    ]
                  }
                },
                "required": [
                  "disposition"
                ]
              },
              "then": {
                "required": [
                  "resolution"
                ]
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
