{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://excelling.cardiffmet/schemas/design-kb.name-bank.schema.json",
  "title": "design-kb: name bank",
  "description": "The bank of first names for fictional students in course content: Welsh names only, split female / male, with the usage rules. Voice specification section 11.6 points here.",
  "type": "object",
  "required": [
    "kbVersion",
    "rules",
    "female",
    "male"
  ],
  "properties": {
    "kbVersion": {
      "$ref": "common.schema.json#/$defs/kbVersion"
    },
    "note": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "female": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][a-zà-ÿŵŷ]+$"
      }
    },
    "male": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][a-zà-ÿŵŷ]+$"
      }
    }
  },
  "additionalProperties": false
}
