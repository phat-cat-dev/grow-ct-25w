# claude.ai relay drop zone, never committed
incoming-docs/

# raw HTML/JS staged for conversion into a src/components or src/extensions
# plugin (see incoming-components/README.md); never committed as-is
incoming-components/*
!incoming-components/README.md

# QAA subject benchmark PDFs (reference material, not build inputs)
docs/contexts/qaa/

# Source-map companion full text (SMAP-1): the tracked map holds quotes of
# at most two sentences; the source's full text, when not otherwise
# readable from a repo-tracked working copy, lives here instead.
source-kb/source-maps/_text/

# Python bytecode cache, left by running tools/*.py directly
__pycache__/

# NB: course-export bundles under exports/ ARE version-controlled (Abbott,
# 10 Oct 2026): the generated course outputs are a deliverable, not a throwaway
# build artifact, so they go to git.

# full Material Symbols variable font (kept local as the subsetting source; ship a subset)
src/extensions/adapt-ab-theme/fonts/material-symbols-outlined.woff2

# VM/transfer excludes
.claude/worktrees/
/src/course
