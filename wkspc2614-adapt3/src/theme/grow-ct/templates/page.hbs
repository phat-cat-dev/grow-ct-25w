{{! ============================================================================
    grow-base OVERRIDE of core page.hbs  —  the LESSON object
    Keeps core hooks (.page__inner, .js-heading, .article__container). Adds the
    lesson hero: the page-level frontmatter (the "lesson-frontmatter") + an
    objectives list. Articles still mount into .article__container.
    ============================================================================ }}
{{import_globals}}
{{import_adapt}}

<div class="page__inner">

  {{#unless Adapt.config._disablePageHeaders}}
  {{#any displayTitle subtitle body instruction}}
  <div class="page__header">
    <div class="page__header-inner">
      <div class="page__header-content">

        {{#if displayTitle}}
        <div class="page__title">
          <div class="page__title-inner js-heading"></div>
        </div>
        {{/if}}

        {{#if subtitle}}
        <div class="page__subtitle">
          <div class="page__subtitle-inner">{{{compile subtitle}}}</div>
        </div>
        {{/if}}

        {{#any body pageBody}}
        <div class="page__body">
          <div class="page__body-inner">
            {{#if pageBody}}{{{compile pageBody}}}{{else}}{{{compile body}}}{{/if}}
          </div>
        </div>
        {{/any}}

        {{#if instruction}}
        <div class="page__instruction">
          <div class="page__instruction-inner">{{{compile instruction}}}</div>
        </div>
        {{/if}}

      </div>
    </div>
  </div>
  {{/any}}
  {{/unless}}

  {{! ---- NEW: lesson hero = page-level frontmatter + objectives ---- }}
  {{#if _grow._frontmatter._isEnabled}}
  <div class="lesson-hero">
    {{> grow-frontmatter _grow._frontmatter role="lesson"}}
  </div>
  {{/if}}

  <div class="article__container">
    {{!-- Articles render here (core hook preserved) --}}
  </div>

</div>
