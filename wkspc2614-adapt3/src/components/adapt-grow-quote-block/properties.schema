{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$anchor": "growQuoteBlock",
  "type": "object",
  "title": "Quote Block (GROW)",
  "properties": {
    "_component": {
      "type": "string",
      "const": "growQuoteBlock",
      "default": "growQuoteBlock",
      "isObjectId": true,
      "readOnly": true,
      "title": "Component type"
    },
    "_classes": {
      "type": "string",
      "title": "CSS classes",
      "default": ""
    },
    "quote": {
      "type": "string",
      "title": "Quote",
      "default": "",
      "required": true,
      "description": "Plain text, no quotation marks - the template adds them. Keep to roughly 60 words or fewer."
    },
    "_attribution": {
      "type": "object",
      "title": "Attribution",
      "required": true,
      "properties": {
        "name": {
          "type": "string",
          "title": "Name",
          "default": "",
          "required": true
        },
        "role": {
          "type": "string",
          "title": "Role",
          "default": ""
        },
        "source": {
          "type": "string",
          "title": "Source",
          "default": ""
        }
      }
    },
    "context": {
      "type": "string",
      "title": "Context",
      "default": "",
      "description": "Optional short framing sentence shown above the quote (roughly 25 words or fewer). Not rendered by congen11's original renderer - added in this port."
    }
  },
  "required": ["_component", "quote", "_attribution"]
}
