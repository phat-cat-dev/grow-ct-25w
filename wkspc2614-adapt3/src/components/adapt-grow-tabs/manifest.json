{
  "manifest": 1,
  "id": "growTabs",
  "name": "adapt-grow-tabs",
  "type": "component",
  "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-grow-tabs.git",
  "summary": "Parts of an essay — GROW component.",
  "theme": {
    "styling": "tokenised",
    "less": "less/grow-tabs.less",
    "tokens": [],
    "fill": {
      "repo": "local:adapt-plugins/themes/adapt-grow-theme",
      "path": "less/_defaults/_grow-tokens.less",
      "note": "Theme supplies the :root token values; dark mode handled there."
    }
  },
  "related": {
    "templates": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "paths": [
        "adapt-grow-tabs/blocks/block-tabs-full.json"
      ]
    },
    "exemplars": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "minimum": 3,
      "paths": [
        "adapt-grow-tabs/exemplars/essay-parts.json",
        "adapt-grow-tabs/exemplars/exam-prep.json",
        "adapt-grow-tabs/exemplars/referencing-styles.json"
      ]
    },
    "docs": {
      "repo": "local:adapt-docs/adapt_abbdev",
      "path": "components/adapt-grow-tabs.md"
    },
    "components": []
  }
}
