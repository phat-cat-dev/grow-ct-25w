{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string",
      "required": true,
      "default": "Fill the blanks activity. Choose a word for each blank to complete the sentence, then select Check.",
      "inputType": "Text",
      "validators": [],
      "help": "Accessible name for the group of blanks, read by screen readers.",
      "translatable": true
    },
    "checkButton": {
      "type": "string",
      "required": true,
      "default": "Check",
      "inputType": "Text",
      "validators": [],
      "help": "Label for the Check button.",
      "translatable": true
    },
    "blankPlaceholder": {
      "type": "string",
      "required": true,
      "default": "Choose a word",
      "inputType": "Text",
      "validators": [],
      "help": "Prompt shown as the first, unselected option in every blank.",
      "translatable": true
    },
    "blankLabel": {
      "type": "string",
      "required": true,
      "default": "Blank {{number}} of {{total}}",
      "inputType": "Text",
      "validators": [],
      "help": "Accessible label for each blank's dropdown. Placeholders: {{number}}, {{total}}.",
      "translatable": true
    },
    "blankCorrect": {
      "type": "string",
      "required": true,
      "default": "Correct",
      "inputType": "Text",
      "validators": [],
      "help": "Status word conveyed to screen readers for a correctly answered blank (not colour alone).",
      "translatable": true
    },
    "blankIncorrect": {
      "type": "string",
      "required": true,
      "default": "Incorrect",
      "inputType": "Text",
      "validators": [],
      "help": "Status word conveyed to screen readers for an incorrectly answered blank (not colour alone).",
      "translatable": true
    },
    "feedbackCorrect": {
      "type": "string",
      "required": true,
      "default": "All correct.",
      "inputType": "Text",
      "validators": [],
      "help": "Overall feedback announced when every blank is correct.",
      "translatable": true
    },
    "feedbackIncorrect": {
      "type": "string",
      "required": true,
      "default": "Check the highlighted blanks.",
      "inputType": "Text",
      "validators": [],
      "help": "Overall feedback announced when one or more blanks are not correct.",
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width",
      "editorOnly": true
    },
    "_component": {
      "type": "string",
      "required": true,
      "default": "growCloze"
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "Choose a word for each blank to complete the sentence, then select Check.",
      "title": "Instruction",
      "inputType": "Text",
      "validators": [],
      "help": "Guidance text shown above the sentence.",
      "translatable": true
    },
    "body": {
      "type": "string",
      "required": false,
      "default": "",
      "title": "Body",
      "inputType": "TextArea",
      "validators": [],
      "help": "Optional lead-in text shown above the sentence.",
      "translatable": true
    },
    "text": {
      "type": "string",
      "required": true,
      "default": "",
      "title": "Sentence",
      "inputType": "TextArea",
      "validators": ["required"],
      "help": "The sentence as plain text with a placeholder for each blank: [[1]], [[2]], and so on. Each number maps to the matching entry (1-based) in Blanks. Example: 'A paragraph usually opens with a [[1]] sentence.'",
      "translatable": true
    },
    "_blanks": {
      "type": "array",
      "required": true,
      "title": "Blanks",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["_options", "_answer"],
        "properties": {
          "_options": {
            "type": "array",
            "required": true,
            "title": "Options",
            "minItems": 2,
            "items": {
              "type": "string",
              "default": ""
            },
            "help": "The choices shown in this blank's dropdown. One of them must be the correct answer below.",
            "translatable": true
          },
          "_answer": {
            "type": "string",
            "required": true,
            "default": "",
            "title": "Correct option",
            "inputType": "Text",
            "validators": ["required"],
            "help": "The correct choice for this blank. Must exactly match one of the Options above.",
            "translatable": true
          }
        }
      }
    },
    "_isCompletionBearing": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Is completion bearing",
      "inputType": "Checkbox",
      "validators": [],
      "help": "When true, the component completes the first time the learner selects Check. Completion is informational only: this is a formative check, never a score or a SCORM interaction."
    }
  }
}
