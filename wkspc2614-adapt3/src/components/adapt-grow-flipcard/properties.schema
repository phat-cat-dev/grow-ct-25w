{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string",
      "required": true,
      "default": "Flip cards. Select each card to reveal its other side.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width",
      "editorOnly": true
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "",
      "title": "Instruction",
      "inputType": "Text",
      "validators": [],
      "help": "Instruction text displayed below the component body.",
      "translatable": true
    },
    "_flipBehaviour": {
      "type": "string",
      "required": false,
      "enum": ["independent", "single"],
      "default": "independent",
      "title": "Flip Behaviour",
      "inputType": {
        "type": "Select",
        "options": ["independent", "single"]
      },
      "validators": [],
      "help": "'independent': cards flip and stay flipped individually. 'single': flipping one card closes any other open card."
    },
    "_isRandomised": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Randomise card order",
      "inputType": "Checkbox",
      "validators": [],
      "help": "When true, the cards are shuffled into a fresh order each time the component is shown."
    },
    "_items": {
      "type": "array",
      "required": true,
      "title": "Cards",
      "help": "Each card has a front face and a back face. Front must have at least one of: title, body, or graphic. Back must have at least one of: title or body.",
      "items": {
        "type": "object",
        "required": true,
        "properties": {
          "_id": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Item ID",
            "inputType": "Text",
            "validators": [],
            "help": "Stable identifier for this card. If blank, index is used. Useful for analytics."
          },
          "_variant": {
            "type": "string",
            "required": false,
            "default": "neutral",
            "title": "Card tone",
            "enum": ["neutral", "positive", "negative"],
            "inputType": { "type": "Select", "options": ["neutral", "positive", "negative"] },
            "validators": [],
            "help": "Optional verdict tone. 'positive' shows a green tick on the back, 'negative' a red cross; 'neutral' (default) shows neither."
          },
          "front": {
            "type": "object",
            "required": true,
            "title": "Front Face",
            "help": "The initially visible face of the card. Must have at least one of: title, body, or graphic.",
            "properties": {
              "title": {
                "type": "string",
                "required": false,
                "default": "",
                "title": "Front Title",
                "inputType": "Text",
                "validators": [],
                "help": "Title displayed on the front face. Also used as the card's accessible name.",
                "translatable": true
              },
              "body": {
                "type": "string",
                "required": false,
                "default": "",
                "title": "Front Body",
                "inputType": "TextArea",
                "validators": [],
                "help": "Body text displayed on the front face.",
                "translatable": true
              },
              "_graphic": {
                "type": "object",
                "required": false,
                "title": "Front Graphic",
                "properties": {
                  "src": {
                    "type": "string",
                    "required": false,
                    "default": "",
                    "title": "Source",
                    "inputType": "Asset:image",
                    "validators": [],
                    "help": "Image displayed on the front face."
                  },
                  "alt": {
                    "type": "string",
                    "required": false,
                    "default": "",
                    "title": "Alternative Text",
                    "inputType": "Text",
                    "validators": [],
                    "help": "Describes the image for screen readers. Leave blank if the image is decorative and the front title provides sufficient context.",
                    "translatable": true
                  }
                }
              }
            }
          },
          "back": {
            "type": "object",
            "required": true,
            "title": "Back Face",
            "help": "The revealed face of the card. Must have at least one of: title or body.",
            "properties": {
              "title": {
                "type": "string",
                "required": false,
                "default": "",
                "title": "Back Title",
                "inputType": "Text",
                "validators": [],
                "help": "Title displayed on the back face.",
                "translatable": true
              },
              "body": {
                "type": "string",
                "required": false,
                "default": "",
                "title": "Back Body",
                "inputType": "TextArea",
                "validators": [],
                "help": "Body text displayed on the back face.",
                "translatable": true
              }
            }
          }
        }
      }
    }
  }
}
