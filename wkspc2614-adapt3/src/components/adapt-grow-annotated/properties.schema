{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://adaptlearning.org/schemas/plugins/components/annotated.json",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string",
      "required": true,
      "default": "Annotated text passage. Select marked phrases to see explanatory notes.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width",
      "editorOnly": true
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "",
      "inputType": "Text",
      "validators": [],
      "help": "Instruction text for the annotated exemplar.",
      "translatable": true
    },
    "_passage": {
      "type": "array",
      "required": true,
      "title": "Passage segments",
      "help": "The passage as an ordered array of segments. Plain segments have only 'text'; annotated segments add '_note' with 'title' and 'body'.",
      "items": {
        "type": "object",
        "required": true,
        "properties": {
          "text": {
            "type": "string",
            "required": true,
            "default": "",
            "title": "Segment text",
            "inputType": "Text",
            "validators": ["required"],
            "help": "The text of this segment (sentence or phrase).",
            "translatable": true
          },
          "_note": {
            "type": "object",
            "required": false,
            "title": "Note",
            "help": "Optional explanatory note for this segment.",
            "properties": {
              "title": {
                "type": "string",
                "required": false,
                "default": "",
                "title": "Note title",
                "inputType": "Text",
                "validators": [],
                "help": "Short heading for the note (e.g. 'Clear thesis statement').",
                "translatable": true
              },
              "body": {
                "type": "string",
                "required": true,
                "default": "",
                "title": "Note body",
                "inputType": "TextArea",
                "validators": ["required"],
                "help": "The explanatory commentary. HTML allowed.",
                "translatable": true
              }
            }
          }
        }
      }
    }
  }
}
