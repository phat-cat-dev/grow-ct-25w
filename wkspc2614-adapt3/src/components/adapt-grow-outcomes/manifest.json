{
  "manifest": 1,
  "id": "growOutcomes",
  "name": "adapt-grow-outcomes",
  "type": "component",
  "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-grow-outcomes.git",
  "summary": "adapt-grow-outcomes — GROW component.",
  "theme": {
    "styling": "tokenised",
    "less": "less/growOutcomes.less",
    "tokens": [
      "--accent",
      "--fs-sm",
      "--h",
      "--ink",
      "--ink-soft",
      "--line",
      "--radius",
      "--s",
      "--space-md",
      "--space-sm",
      "--space-xs"
    ],
    "fill": {
      "repo": "local:adapt-plugins/themes/adapt-grow-theme",
      "path": "less/_defaults/_grow-tokens.less",
      "note": "Theme supplies the :root token values; dark mode handled there."
    }
  },
  "related": {
    "templates": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "paths": [
        "adapt-grow-outcomes/blocks/block-outcomes-full.json"
      ]
    },
    "exemplars": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "minimum": 3,
      "paths": [
        "adapt-grow-outcomes/exemplars/critical-reading-outcomes.json",
        "adapt-grow-outcomes/exemplars/essay-writing-outcomes.json",
        "adapt-grow-outcomes/exemplars/referencing-outcomes.json"
      ]
    },
    "docs": {
      "repo": "local:adapt-docs/adapt_abbdev",
      "path": "components/adapt-grow-outcomes.md"
    },
    "components": []
  }
}
