{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "navAriaLabel": {
      "type": "string",
      "required": true,
      "default": "Learning steps",
      "inputType": "Text",
      "validators": [],
      "help": "Accessible name for the group of step buttons.",
      "translatable": true
    },
    "stepLabel": {
      "type": "string",
      "required": true,
      "default": "Step {{number}}: {{label}}",
      "inputType": "Text",
      "validators": [],
      "help": "Accessible name of a step button. Placeholders: {{number}}, {{label}}.",
      "translatable": true
    },
    "stepLabelCompleted": {
      "type": "string",
      "required": true,
      "default": "Step {{number}}: {{label}}, completed",
      "inputType": "Text",
      "validators": [],
      "help": "Accessible name of a step button once you have marked it complete. Placeholders: {{number}}, {{label}}.",
      "translatable": true
    },
    "statusText": {
      "type": "string",
      "required": true,
      "default": "Step {{current}} of {{total}}. {{completed}} of {{total}} steps marked complete.",
      "inputType": "Text",
      "validators": [],
      "help": "Live status line read out as you move between steps. Placeholders: {{current}}, {{total}}, {{completed}}.",
      "translatable": true
    },
    "sequenceCompleteText": {
      "type": "string",
      "required": true,
      "default": "You have marked every step complete.",
      "inputType": "Text",
      "validators": [],
      "help": "Appended to the status line once every step is marked complete.",
      "translatable": true
    },
    "backButton": {
      "type": "string",
      "required": true,
      "default": "Back",
      "inputType": "Text",
      "validators": [],
      "help": "Label for the button that moves to the previous step.",
      "translatable": true
    },
    "nextButton": {
      "type": "string",
      "required": true,
      "default": "Next step",
      "inputType": "Text",
      "validators": [],
      "help": "Label for the button that moves to the next step.",
      "translatable": true
    },
    "markStepButton": {
      "type": "string",
      "required": true,
      "default": "Mark step complete",
      "inputType": "Text",
      "validators": [],
      "help": "Label for the button that marks the current step complete.",
      "translatable": true
    },
    "stepCompletedButton": {
      "type": "string",
      "required": true,
      "default": "Step completed",
      "inputType": "Text",
      "validators": [],
      "help": "Text shown in place of the mark-complete button once the current step is complete.",
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width",
      "editorOnly": true
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "",
      "title": "Instruction",
      "inputType": "Text",
      "validators": [],
      "help": "Optional guidance text shown above the step buttons.",
      "translatable": true
    },
    "_isCompletionBearing": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Is completion bearing",
      "inputType": "Checkbox",
      "validators": [],
      "help": "When false the component is formative only and completes simply on being seen (inview), contributing no deliberate signal. When true, completion becomes an explicit learner action governed by Completion criteria. Never a score and never a SCORM interaction."
    },
    "_completionCriteria": {
      "type": "string",
      "required": false,
      "enum": ["allStepsComplete", "finalStep"],
      "default": "allStepsComplete",
      "title": "Completion criteria",
      "inputType": { "type": "Select", "options": ["allStepsComplete", "finalStep"] },
      "validators": [],
      "help": "Only applies when Is completion bearing is true. 'allStepsComplete': you must mark every step complete. 'finalStep': the component completes when you reach the final step."
    },
    "_labelDisplay": {
      "type": "string",
      "required": false,
      "enum": ["expandOnActive", "always"],
      "default": "expandOnActive",
      "title": "Label display",
      "inputType": { "type": "Select", "options": ["expandOnActive", "always"] },
      "validators": [],
      "help": "'expandOnActive': labels stay collapsed and expand on hover, keyboard focus and for the current step (touch and narrow screens always show them). 'always': labels stay expanded on all pointer types."
    },
    "_steps": {
      "type": "array",
      "required": true,
      "title": "Steps",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": true,
        "properties": {
          "_icon": {
            "type": "string",
            "required": true,
            "default": "",
            "title": "Icon",
            "inputType": "Text",
            "validators": [],
            "help": "Either a Material Symbols icon name (for example 'explore', 'edit', 'lightbulb') OR an inline SVG snippet beginning with <svg. Inline SVG needs no font and inherits the current colour (stroke). Material Symbols require the Material Symbols font to be present in the course."
          },
          "label": {
            "type": "string",
            "required": true,
            "default": "",
            "title": "Label",
            "inputType": "Text",
            "validators": [],
            "help": "Short label for the step. Hidden at rest; expands when the step is current or on hover and keyboard focus. Keep it short.",
            "translatable": true
          },
          "body": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Activity",
            "inputType": "TextArea",
            "validators": [],
            "help": "The step's activity or explanation (HTML). Shown only when this step is the current step.",
            "translatable": true
          }
        }
      }
    }
  }
}
