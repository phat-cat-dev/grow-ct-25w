{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$anchor": "growStatBlock",
  "type": "object",
  "title": "Stat Block (GROW)",
  "properties": {
    "_component": {
      "type": "string",
      "const": "growStatBlock",
      "default": "growStatBlock",
      "isObjectId": true,
      "readOnly": true,
      "title": "Component type"
    },
    "_classes": {
      "type": "string",
      "title": "CSS classes",
      "default": ""
    },
    "title": {
      "type": "string",
      "title": "Title",
      "default": "",
      "description": "Rendered as an h2. ~10 words or fewer."
    },
    "_items": {
      "type": "array",
      "title": "Stats",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "title": "Stat",
        "properties": {
          "value": {
            "type": "string",
            "title": "Value",
            "default": "",
            "required": true,
            "description": "A string, not a number - allows formats like \"74%\", \"3 in 5\", \"Over 80%\". ~5 words or fewer."
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": "",
            "required": true,
            "description": "~15 words or fewer."
          },
          "context": {
            "type": "string",
            "title": "Context",
            "default": "",
            "description": "~20 words or fewer."
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "",
            "description": "Not schema-required, but source authoring guidance treats this as mandatory by convention: 'Always provide a source. If not known, do not include this stat.'"
          }
        },
        "required": ["value", "label"]
      },
      "description": "A single stat should be a Callout instead - this component is a collection (2-6 items)."
    }
  },
  "required": ["_component", "_items"]
}
