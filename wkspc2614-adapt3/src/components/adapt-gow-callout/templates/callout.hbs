{{!--
  BEM classes (callout, callout__title, callout__body) are carried over from
  congen11's renderers/elesson/components/callout.njk so the ported LESS can be
  reused without renaming selectors.
--}}
<div class="component__inner callout__inner">
  <aside class="callout callout--{{_calloutType}}" data-component="callout">
    {{#if title}}
      <h3 class="callout__title">{{title}}</h3>
    {{/if}}
    <div class="callout__body">
      {{{body}}}
    </div>
  </aside>
</div>
