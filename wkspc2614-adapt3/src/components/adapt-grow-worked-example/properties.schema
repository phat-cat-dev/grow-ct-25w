{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://adaptlearning.org/schemas/plugins/components/growWorkedExample.json",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string",
      "required": true,
      "default": "Worked example. Expand to read it.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width",
      "editorOnly": true
    }
  }
}
