{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string",
      "required": true,
      "default": "Hero banner.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width",
      "editorOnly": true
    },
    "_variant": {
      "type": "string",
      "required": false,
      "enum": ["neutral", "accent", "tinted"],
      "default": "neutral",
      "title": "Hero fill",
      "inputType": {
        "type": "Select",
        "options": ["neutral", "accent", "tinted"]
      },
      "validators": [],
      "help": "Background treatment: sunken neutral band, bold accent fill, or a faint accent tint."
    },
    "_align": {
      "type": "string",
      "required": false,
      "enum": ["left", "center"],
      "default": "left",
      "title": "Text alignment",
      "inputType": {
        "type": "Select",
        "options": ["left", "center"]
      },
      "validators": []
    },
    "_animate": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Entrance animation",
      "inputType": "Checkbox",
      "help": "Add a small self-contained rise-in entrance (respects reduced-motion)."
    },
    "_icon": {
      "type": "string",
      "required": false,
      "default": "",
      "title": "Icon class",
      "inputType": "Text",
      "validators": [],
      "help": "Optional leading icon-font class (e.g. 'icon-star'). Sets the icon-text layout."
    },
    "eyebrow": {
      "type": "string",
      "required": false,
      "default": "",
      "title": "Eyebrow",
      "inputType": "Text",
      "validators": [],
      "help": "Small label above the title.",
      "translatable": true
    },
    "heading": {
      "type": "string",
      "required": false,
      "default": "",
      "title": "Heading",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    },
    "body": {
      "type": "string",
      "required": false,
      "default": "",
      "title": "Body",
      "inputType": "TextArea",
      "validators": [],
      "translatable": true
    },
    "_media": {
      "type": "object",
      "required": false,
      "title": "Media",
      "properties": {
        "_type": {
          "type": "string",
          "required": false,
          "enum": ["none", "image", "video"],
          "default": "none",
          "title": "Media type",
          "inputType": {
            "type": "Select",
            "options": ["none", "image", "video"]
          },
          "validators": []
        },
        "_placement": {
          "type": "string",
          "required": false,
          "enum": ["none", "side", "background"],
          "default": "none",
          "title": "Media placement",
          "inputType": {
            "type": "Select",
            "options": ["none", "side", "background"]
          },
          "validators": [],
          "help": "Beside the text (two columns at width), or behind the text under a scrim."
        },
        "src": {
          "type": "string",
          "required": false,
          "default": "",
          "title": "Source",
          "inputType": "Asset:image",
          "validators": []
        },
        "alt": {
          "type": "string",
          "required": false,
          "default": "",
          "title": "Alt text",
          "inputType": "Text",
          "validators": [],
          "translatable": true
        },
        "poster": {
          "type": "string",
          "required": false,
          "default": "",
          "title": "Video poster",
          "inputType": "Asset:image",
          "validators": []
        },
        "_controls": {
          "type": "boolean",
          "required": false,
          "default": false,
          "title": "Video controls"
        }
      }
    },
    "_ctas": {
      "type": "array",
      "required": false,
      "title": "Call-to-action buttons",
      "help": "Optional action buttons rendered as .ab.btn.",
      "items": {
        "type": "object",
        "required": true,
        "properties": {
          "text": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Button text",
            "inputType": "Text",
            "validators": [],
            "translatable": true
          },
          "url": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Button URL",
            "inputType": "Text",
            "validators": []
          },
          "_variant": {
            "type": "string",
            "required": false,
            "default": "accent",
            "title": "Button variant",
            "inputType": "Text",
            "validators": [],
            "help": "A .ab.btn variant (accent, neutral, success, danger, warning, info)."
          },
          "_outline": {
            "type": "boolean",
            "required": false,
            "default": false,
            "title": "Outline button",
            "inputType": "Checkbox"
          }
        }
      }
    }
  }
}
