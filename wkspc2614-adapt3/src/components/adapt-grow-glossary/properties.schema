{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://adaptlearning.org/schemas/plugins/components/glossary.json",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string",
      "required": true,
      "default": "Glossary passage. Select marked terms to see their definitions.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width",
      "editorOnly": true
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "",
      "inputType": "Text",
      "validators": [],
      "help": "Instruction text for the glossary passage.",
      "translatable": true
    },
    "_passage": {
      "type": "array",
      "required": true,
      "title": "Passage segments",
      "help": "The passage as an ordered array of segments. Plain segments have only 'text'; term segments add '_term' with 'term' (headword) and 'definition'. IMPORTANT: Mark exactly 2–8 terms per passage. The schema cannot enforce this constraint on the marked subset; a console warning will appear if violated.",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": true,
        "properties": {
          "text": {
            "type": "string",
            "required": true,
            "default": "",
            "title": "Segment text",
            "inputType": "Text",
            "validators": ["required"],
            "help": "The text of this segment (word, phrase, or sentence).",
            "translatable": true
          },
          "_term": {
            "type": "object",
            "required": false,
            "title": "Term definition",
            "help": "Optional term definition for this segment. Mark only the first use of each term.",
            "properties": {
              "term": {
                "type": "string",
                "required": true,
                "default": "",
                "title": "Headword",
                "inputType": "Text",
                "validators": ["required"],
                "help": "The glossary headword (may differ from segment text, e.g. 'reference' for 'referencing').",
                "translatable": true
              },
              "definition": {
                "type": "string",
                "required": true,
                "default": "",
                "title": "Definition",
                "inputType": "TextArea",
                "validators": ["required"],
                "help": "The definition. First sentence must be self-contained. No contractions. HTML allowed.",
                "translatable": true
              }
            }
          }
        }
      }
    }
  }
}
