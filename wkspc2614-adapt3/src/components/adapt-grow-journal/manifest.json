{
  "manifest": 1,
  "id": "growJournal",
  "name": "adapt-grow-journal",
  "type": "component",
  "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-grow-journal.git",
  "summary": "Journal — GROW component.",
  "theme": {
    "styling": "tokenised",
    "less": "less/grow-journal.less",
    "tokens": [
      "--accent",
      "--c-negative",
      "--fs-base",
      "--ink",
      "--ink-soft",
      "--line",
      "--space-sm",
      "--surface-1"
    ],
    "fill": {
      "repo": "local:adapt-plugins/themes/adapt-grow-theme",
      "path": "less/_defaults/_grow-tokens.less",
      "note": "Theme supplies the :root token values; dark mode handled there."
    }
  },
  "related": {
    "templates": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "paths": [
        "adapt-grow-journal/blocks/block-journal-reflection.json"
      ]
    },
    "exemplars": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "minimum": 3,
      "paths": [
        "adapt-grow-journal/exemplars/notes-reading-log.json",
        "adapt-grow-journal/exemplars/reflection-feedback-action.json",
        "adapt-grow-journal/exemplars/reflection-learning.json"
      ]
    },
    "docs": {
      "repo": "local:adapt-docs/adapt_abbdev",
      "path": "components/adapt-grow-journal.md"
    },
    "components": []
  }
}
