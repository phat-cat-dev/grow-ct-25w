{{!--
  Structure: instruction/body header, a radio-like category palette, a live
  progress counter, then each passage rendered as its pre-resolved segment
  array (`_segments`, built by TextTaggingModel._buildSegments() - never the
  raw `text` + `_taggableSpans` fields directly, and never via `innerHTML`).

  A passage with no `_taggableSpans` resolves to a single non-span segment,
  so it naturally renders as a read-only "contrast passage" here with no
  extra template branching needed.

  Classes prefixed `js-` are behavioural hooks TextTaggingView binds events
  to / queries - do not rename without updating the view. `text-tagging__*`
  (no `js-` prefix) are purely presentational, styled in
  ../less/textTagging.less.
--}}
<div class="component__inner text-tagging__inner">

  <div class="component__header">
    {{#if title}}
      <h1 class="component__title">{{title}}</h1>
    {{/if}}
    {{#if body}}
      <div class="component__body">{{{body}}}</div>
    {{/if}}
    {{#if instruction}}
      <div class="component__instruction">{{{instruction}}}</div>
    {{/if}}
  </div>

  <div class="component__widget text-tagging" data-component="textTagging">

    <div class="text-tagging__palette" role="group" aria-label="Tag categories">
      {{#each _tagCategories}}
        <button
          type="button"
          class="text-tagging__tag-btn text-tagging__tag-btn--tag-{{@index}} js-text-tagging-tag-btn"
          data-tag-index="{{@index}}"
          aria-pressed="false"
          tabindex="0"
          {{#if description}}title="{{description}}"{{/if}}
        >{{label}}</button>
      {{/each}}
    </div>

    <div class="text-tagging__progress-counter js-text-tagging-progress-counter text-tagging__progress-counter--none">
      <span class="js-text-tagging-tagged-count">0</span> / <span class="js-text-tagging-total-count">0</span> tagged
    </div>

    {{#each _passages}}
      <div class="text-tagging__passage" data-passage-id="{{_passageId}}">
        {{#if label}}
          <h3 class="text-tagging__passage-label">{{label}}</h3>
        {{/if}}
        <p class="text-tagging__passage-text">
          {{#each _segments}}
            {{#if _isSpan}}
              <span
                class="text-tagging__tag-target js-text-tagging-tag-target"
                data-span-id="{{_spanId}}"
                role="button"
                tabindex="0"
                aria-label="{{text}}"
              >{{text}}</span>
            {{else}}
              {{text}}
            {{/if}}
          {{/each}}
        </p>
      </div>
    {{/each}}

  </div>

  <ul class="text-tagging__feedback js-text-tagging-feedback" aria-live="polite" hidden></ul>

  <div class="btn__container"></div>

</div>
