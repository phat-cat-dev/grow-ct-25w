{
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "type": "object",
  "properties": {
    "_component": {
      "type": "string",
      "default": "references",
      "editorOnly": true
    },
    "_supportedLayout": {
      "type": "string",
      "default": "full",
      "editorOnly": true
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "",
      "inputType": "Text",
      "validators": [],
      "translatable": true,
      "help": "Optional instruction text shown above the list."
    },
    "_items": {
      "type": "array",
      "required": true,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "required": true,
            "inputType": "Text",
            "translatable": true,
            "help": "Display text for the reference."
          },
          "href": {
            "type": "string",
            "required": true,
            "inputType": "Text",
            "help": "Clickable URL to the resource itself. Always populated with a real link; whether that link is confirmed or still a placeholder is stated separately in _hrefStatus, not encoded in this field."
          },
          "_hrefStatus": {
            "type": "string",
            "required": true,
            "inputType": "Select",
            "options": ["placeholder", "confirmed"],
            "help": "Whether href above is a real, confirmed link or a placeholder awaiting the real one. Replaces the old convention of writing href as a bare '#' to mean 'not confirmed yet' (RF-3, open-decisions.md, superseded in part): href is always a populated value now, and this field carries the confirmation state explicitly instead."
          },
          "type": {
            "type": "string",
            "required": true,
            "default": "book",
            "inputType": "Text",
            "help": "Free-text category, e.g. 'book' or 'external'. Not a locked enum, add new values as needed."
          },
          "permalink": {
            "type": "string",
            "required": false,
            "inputType": "Text",
            "help": "Optional university library catalogue permalink for the same resource. Independent of href, not a fallback."
          }
        }
      }
    }
  }
}
