{{!--
  BEM base classes (quote-block, quote-block__content, quote-block__attribution)
  follow congen11's intended naming convention. quote-block__context is new in
  this port - the source renderer never output the `context` field at all.
--}}
<div class="component__inner quoteBlock__inner">
  <blockquote class="quote-block" data-component="quote-block">
    {{#if context}}
      <p class="quote-block__context">{{context}}</p>
    {{/if}}
    <div class="quote-block__content">
      &ldquo;{{quote}}&rdquo;
    </div>
    <cite class="quote-block__attribution">
      <span class="quote-block__attribution-name">{{_attribution.name}}</span>
      {{#if _attribution.role}}<span class="quote-block__attribution-role">, {{_attribution.role}}</span>{{/if}}
      {{#if _attribution.source}}<span class="quote-block__attribution-source">&mdash; {{_attribution.source}}</span>{{/if}}
    </cite>
  </blockquote>
</div>
