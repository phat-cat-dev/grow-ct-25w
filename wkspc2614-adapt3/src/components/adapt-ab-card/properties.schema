{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string",
      "required": true,
      "default": "Information cards.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "both",
      "editorOnly": true
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "",
      "title": "Instruction",
      "inputType": "Text",
      "validators": [],
      "help": "Instruction text displayed below the component body.",
      "translatable": true
    },
    "_variant": {
      "type": "string",
      "required": false,
      "enum": ["neutral", "accent", "do", "dont", "advice", "action", "starting", "feedback-pos", "feedback-neg"],
      "default": "neutral",
      "title": "Card variant",
      "inputType": {
        "type": "Select",
        "options": ["neutral", "accent", "do", "dont", "advice", "action", "starting", "feedback-pos", "feedback-neg"]
      },
      "validators": [],
      "help": "Default variant applied to every card. A card may override it with its own _variant."
    },
    "_isGroup": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Force card group",
      "inputType": "Checkbox",
      "help": "Render as a .card-group even with a single card."
    },
    "_hoverAnimate": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Lift on hover",
      "inputType": "Checkbox",
      "help": "Add the hover-animate class so cards lift on hover."
    },
    "_tinted": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Tinted surface",
      "inputType": "Checkbox",
      "help": "Wash the card surface and cap with a faint tint drawn from the variant accent."
    },
    "_items": {
      "type": "array",
      "required": true,
      "title": "Cards",
      "help": "Each card. A card should carry at least a title or text.",
      "items": {
        "type": "object",
        "required": true,
        "properties": {
          "_id": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Item ID",
            "inputType": "Text",
            "validators": [],
            "help": "Stable identifier for this card. Useful for analytics."
          },
          "_variant": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Card variant override",
            "inputType": "Text",
            "validators": [],
            "help": "Optional per-card override of the component _variant."
          },
          "_withIcon": {
            "type": "boolean",
            "required": false,
            "default": false,
            "title": "With icon",
            "inputType": "Checkbox"
          },
          "_icon": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Icon class",
            "inputType": "Text",
            "validators": [],
            "help": "Optional icon-font class (e.g. 'icon-star'). Only used when With icon is on."
          },
          "header": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Card header",
            "inputType": "Text",
            "validators": [],
            "translatable": true
          },
          "title": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Card title",
            "inputType": "Text",
            "validators": [],
            "translatable": true
          },
          "subtitle": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Card subtitle",
            "inputType": "Text",
            "validators": [],
            "translatable": true
          },
          "text": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Card text",
            "inputType": "TextArea",
            "validators": [],
            "translatable": true
          },
          "footer": {
            "type": "string",
            "required": false,
            "default": "",
            "title": "Card footer",
            "inputType": "Text",
            "validators": [],
            "translatable": true
          },
          "_graphic": {
            "type": "object",
            "required": false,
            "title": "Card image (top)",
            "properties": {
              "src": {
                "type": "string",
                "required": false,
                "default": "",
                "title": "Source",
                "inputType": "Asset:image",
                "validators": []
              },
              "alt": {
                "type": "string",
                "required": false,
                "default": "",
                "title": "Alt text",
                "inputType": "Text",
                "validators": [],
                "translatable": true
              }
            }
          },
          "_link": {
            "type": "object",
            "required": false,
            "title": "Card link",
            "properties": {
              "text": {
                "type": "string",
                "required": false,
                "default": "",
                "title": "Link text",
                "inputType": "Text",
                "validators": [],
                "translatable": true
              },
              "url": {
                "type": "string",
                "required": false,
                "default": "",
                "title": "Link URL",
                "inputType": "Text",
                "validators": []
              }
            }
          }
        }
      }
    }
  }
}
