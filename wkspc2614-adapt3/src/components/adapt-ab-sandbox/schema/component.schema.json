{
  "$anchor": "ab-sandbox-component",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$merge": {
    "source": {
      "$ref": "component"
    },
    "with": {
      "properties": {
        "_supportedLayout": {
          "type": "string",
          "title": "Supported layout",
          "default": "both",
          "enum": [
            "full-width",
            "half-width",
            "both"
          ],
          "_adapt": {
            "editorOnly": true
          }
        },
        "displayTitle": {
          "type": "string",
          "title": "Display title",
          "description": "When viewing an element - this is the title that will be displayed on the page",
          "default": "AB Sandbox",
          "_adapt": {
            "translatable": true
          }
        },
        "body": {
          "type": "string",
          "title": "Body",
          "default": "This component exists purely to prove the component build pipeline.",
          "_adapt": {
            "translatable": true
          }
        },
        "instruction": {
          "type": "string",
          "title": "Instruction",
          "default": "",
          "_adapt": {
            "translatable": true
          }
        }
      }
    }
  }
}
