{{!--
  adapt-grow-promptbuilder
  Lead-in + one block per prompt part (label, help, example chips, an editable
  field), then the live-assembled prompt with a copy button and a "why" note.
--}}
<div class="component__inner growPromptBuilder__inner">
  <div class="prompt-builder" data-component="grow-promptbuilder">

    {{#if displayTitle}}
      <div class="prompt-builder__title" role="heading" aria-level="3">{{{compile displayTitle}}}</div>
    {{/if}}
    {{#if body}}
      <div class="prompt-builder__lead">{{{compile body}}}</div>
    {{/if}}
    {{#if instruction}}
      <div class="prompt-builder__instruction">{{{compile instruction}}}</div>
    {{/if}}

    <div class="prompt-builder__parts">
      {{#each _parts}}
        <div class="prompt-builder__part">
          <label class="prompt-builder__part-label" for="{{@root._id}}-pb-{{_key}}">{{{compile label}}}</label>
          {{#if help}}<div class="prompt-builder__part-help">{{{compile help}}}</div>{{/if}}
          {{#if _options.length}}
            <select id="{{@root._id}}-pb-{{_key}}" class="prompt-builder__input prompt-builder__select js-pb-input" data-key="{{_key}}">
              <option value="">{{#if placeholder}}{{placeholder}}{{else}}Choose...{{/if}}</option>
              {{#each _options}}
                <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          {{else}}
            {{#if _chips}}
              <div class="prompt-builder__chips" role="group" aria-label="Examples">
                {{#each _chips}}
                  <button type="button" class="prompt-builder__chip js-pb-chip" data-key="{{../_key}}" data-text="{{this}}">{{this}}</button>
                {{/each}}
              </div>
            {{/if}}
            <textarea id="{{@root._id}}-pb-{{_key}}" class="prompt-builder__input js-pb-input" data-key="{{_key}}" rows="2" placeholder="{{placeholder}}"></textarea>
          {{/if}}
        </div>
      {{/each}}
    </div>

    <div class="prompt-builder__result">
      <div class="prompt-builder__result-label">{{#if _assembledLabel}}{{_assembledLabel}}{{else}}Your prompt{{/if}}</div>
      <output class="prompt-builder__output js-pb-output" aria-live="polite"></output>
      <div class="prompt-builder__actions">
        <button type="button" class="prompt-builder__copy js-pb-copy" disabled>
          <span class="prompt-builder__copy-icon" aria-hidden="true"></span>{{#if _copyText}}{{_copyText}}{{else}}Copy prompt{{/if}}
        </button>
        <button type="button" class="prompt-builder__clear js-pb-clear">{{#if _clearText}}{{_clearText}}{{else}}Clear{{/if}}</button>
      </div>
    </div>

    {{#if _whyText}}
      <div class="prompt-builder__why">{{{compile _whyText}}}</div>
    {{/if}}

  </div>
</div>
