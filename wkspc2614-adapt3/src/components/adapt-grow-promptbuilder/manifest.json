{
  "manifest": 1,
  "id": "growPromptBuilder",
  "name": "adapt-grow-promptbuilder",
  "type": "component",
  "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-grow-promptbuilder.git",
  "summary": "Build a learning prompt — GROW component.",
  "theme": {
    "styling": "tokenised",
    "less": "less/growPromptBuilder.less",
    "tokens": [
      "--accent-ink",
      "--ink",
      "--ink-soft",
      "--line",
      "--shadow",
      "--surface-1",
      "--surface-2"
    ],
    "fill": {
      "repo": "local:adapt-plugins/themes/adapt-grow-theme",
      "path": "less/_defaults/_grow-tokens.less",
      "note": "Theme supplies the :root token values; dark mode handled there."
    }
  },
  "related": {
    "templates": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "paths": [
        "adapt-grow-promptbuilder/blocks/block-promptbuilder-full.json"
      ]
    },
    "exemplars": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "minimum": 3,
      "paths": [
        "adapt-grow-promptbuilder/exemplars/promptbuilder-feedback-request.json",
        "adapt-grow-promptbuilder/exemplars/promptbuilder-learning-prompt.json",
        "adapt-grow-promptbuilder/exemplars/promptbuilder-revision-quiz.json"
      ]
    },
    "docs": {
      "repo": "local:adapt-docs/adapt_abbdev",
      "path": "components/adapt-grow-promptbuilder.md"
    },
    "components": []
  }
}
