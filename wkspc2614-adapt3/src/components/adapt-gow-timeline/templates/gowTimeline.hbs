{{!--
  Base classes (timeline, __title, __track, __event, __marker, __content,
  __date, __event-title, __description) are carried over from congen11's
  renderers/elesson/components/timeline.njk. `timeline__event--highlight` is
  new - the source schema declared `highlight` but the renderer never
  implemented it. Iterates `_displayItems` (computed by TimelineView to apply
  the ascending/descending direction) rather than `_items` directly, since the
  source renderer never implemented reversal either.
--}}
<div class="component__inner timeline__inner">
  <div class="timeline" data-component="timeline">
    {{#if title}}
      <h2 class="timeline__title">{{title}}</h2>
    {{/if}}
    <div class="timeline__track">
      {{#each _displayItems}}
        <div class="timeline__event{{#if _highlight}} timeline__event--highlight{{/if}}{{#if ../_reveal}} timeline__event--revealable{{/if}}">
          <div class="timeline__marker"></div>
          <div class="timeline__content">
            <div class="timeline__date">{{dateLabel}}</div>
            {{#if ../_reveal}}
              {{#if body}}
                <button type="button" class="timeline__event-toggle js-timeline-toggle" aria-expanded="false">
                  <span class="timeline__event-title">{{title}}</span>
                  <span class="timeline__toggle-icon" aria-hidden="true"></span>
                </button>
                <div class="timeline__description" aria-hidden="true">{{{body}}}</div>
              {{else}}
                <h4 class="timeline__event-title">{{title}}</h4>
              {{/if}}
            {{else}}
              <h4 class="timeline__event-title">{{title}}</h4>
              {{#if body}}
                <div class="timeline__description">{{{body}}}</div>
              {{/if}}
            {{/if}}
          </div>
        </div>
      {{/each}}
    </div>
  </div>
</div>
