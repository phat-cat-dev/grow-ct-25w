{
  "manifest": 1,
  "id": "growChecklist",
  "name": "adapt-grow-checklist",
  "type": "component",
  "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-grow-checklist.git",
  "summary": "Accessible, tickable checklist (collapsible accordion) of 4-8 yes/no study-skills checks; completes on first open and passes the trickle.",
  "theme": {
    "styling": "tokenised",
    "less": "less/grow-checklist.less",
    "tokens": [
      "--accent", "--accent-ink", "--surface-1", "--surface-2",
      "--ink", "--ink-soft", "--line"
    ],
    "fill": {
      "repo": "local:adapt-plugins/themes/adapt-grow-theme",
      "path": "less/_defaults/_grow-tokens.less",
      "note": "Theme supplies the :root token values; dark mode handled there. Migrated from the earlier ab-* token set to GROW tokens by meaning."
    }
  },
  "related": {
    "templates": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "paths": [
        "adapt-grow-checklist/blocks/block-checklist-full.json"
      ]
    },
    "exemplars": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "minimum": 3,
      "paths": [
        "adapt-grow-checklist/exemplars/referencing-check.json",
        "adapt-grow-checklist/exemplars/before-you-submit.json",
        "adapt-grow-checklist/exemplars/reading-actively.json"
      ]
    },
    "docs": {
      "repo": "local:adapt-docs/adapt_abbdev",
      "path": "components/adapt-grow-checklist.md"
    },
    "components": []
  }
}
