{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://adaptlearning.org/schemas/plugins/components/checklist.json",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string",
      "required": true,
      "default": "Checklist. Work through each item and tick it when done.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width",
      "editorOnly": true
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "",
      "inputType": "Text",
      "validators": [],
      "help": "Instruction text for the checklist.",
      "translatable": true
    },
    "_items": {
      "type": "array",
      "required": true,
      "title": "Checklist items",
      "help": "The checklist items. Each item is a concrete action the learner can tick off. Items should be answerable yes/no without judgement. Provide 4-8 items.",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": true,
        "properties": {
          "text": {
            "type": "string",
            "required": true,
            "default": "",
            "title": "Item text",
            "inputType": "Text",
            "validators": ["required"],
            "help": "A concrete action phrased as a yes/no check. Example: 'Have I checked every in-text citation appears in my reference list?'",
            "translatable": true
          }
        }
      }
    }
  }
}
