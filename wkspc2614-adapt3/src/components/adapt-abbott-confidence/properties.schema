{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string", "required": true,
      "default": "Confidence check. Rate how confident you feel about each statement, then submit.",
      "inputType": "Text", "validators": [], "translatable": true
    },
    "ariaScaleName": {
      "type": "string", "required": true, "default": "confidence",
      "inputType": "Text", "validators": [],
      "help": "Name announced for the rating scale.", "translatable": true
    },
    "ariaItemRated": {
      "type": "string", "required": true,
      "default": "{{{item}}}: rated {{{label}}}, {{{value}}} of {{{max}}}",
      "inputType": "Text", "validators": [],
      "help": "Announced when a rating is selected. Placeholders: item, label, value, max.",
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string", "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width", "editorOnly": true
    },
    "_mode": {
      "type": "string", "required": true, "enum": ["pre", "post"], "default": "pre",
      "title": "Mode", "inputType": { "type": "Select", "options": ["pre", "post"] },
      "validators": ["required"],
      "help": "\"pre\" (before the lesson) or \"post\" (after). The PRE carries _items and _scale; the POST carries _feedback and _hasSummativeFollowing and inherits the pre's items/scale by group id."
    },
    "_selfAssessmentGroupId": {
      "type": "string", "required": true, "default": "",
      "title": "Self-assessment group id", "inputType": "Text", "validators": ["required"],
      "help": "Identical on the pre and post of a pair (lesson-derived). The post finds its pre by matching this; state, items and scale key off it."
    },
    "instruction": {
      "type": "string", "required": false,
      "default": "Rate how confident you feel about each statement, then select Submit.",
      "inputType": "Text", "validators": [], "translatable": true
    },
    "ariaQuestion": {
      "type": "string", "required": false, "default": "",
      "inputType": "Text", "validators": [],
      "help": "Screen-reader text; if blank, uses title + body + instruction.", "translatable": true
    },
    "_items": {
      "type": "array", "required": false,
      "title": "Items (authored on the PRE)",
      "help": "Each item is a lesson learning outcome phrased as a can-do confidence statement (SA-2). Authored on the PRE only; the post leaves this empty and inherits by group id.",
      "items": {
        "type": "object", "required": true,
        "properties": {
          "_id": {
            "type": "string", "required": true, "default": "",
            "inputType": "Text", "validators": ["required"],
            "help": "Stable unique id within the group. Keys the stored rating and any per-item feedback override. Stable across pre/post."
          },
          "text": {
            "type": "string", "required": true, "default": "",
            "inputType": "Text", "validators": ["required"],
            "help": "The confidence statement, e.g. \"...identify the steer in an essay question.\"", "translatable": true
          }
        }
      }
    },
    "_scale": {
      "type": "object", "required": false,
      "title": "Confidence scale (authored on the PRE)",
      "help": "Shared by every item. Authored on the PRE; inherited by the post so pre and post are identical.",
      "properties": {
        "_labels": {
          "type": "array", "required": false,
          "title": "Scale labels (low to high)",
          "help": "One label per point, low to high. Five per SA-3. Stored value is the 1-based index.",
          "items": { "type": "string", "default": "", "inputType": "Text", "validators": [], "translatable": true },
          "default": ["Not at all confident", "Slightly confident", "Fairly confident", "Very confident", "Completely confident"]
        }
      }
    },
    "_hasSummativeFollowing": {
      "type": "boolean", "required": false, "default": false,
      "title": "Has summative following (POST)", "inputType": "Checkbox", "validators": [],
      "help": "POST only. Set at assembly from the lesson shell. true -> hand-off points to the assessment ahead; false -> points to application/practice. Default false."
    },
    "_preConfirmation": {
      "type": "string", "required": false,
      "default": "Thank you. You will revisit these statements at the end of the lesson to see how your confidence has changed.",
      "title": "Pre confirmation message", "inputType": "TextArea", "validators": [],
      "help": "PRE only. Shown after the learner submits the pre-ratings.", "translatable": true
    },
    "_feedback": {
      "type": "object", "required": false, "title": "Feedback (POST)",
      "help": "POST only. Five movement-pattern templates, three summary variants, and the standalone (no-pre) text. Templates use {{item}} for the statement text.",
      "properties": {
        "_patterns": {
          "type": "object", "required": false, "title": "Movement pattern templates",
          "properties": {
            "rose":       { "type": "string", "required": false, "default": "", "title": "Rose", "inputType": "TextArea", "validators": [], "help": "Pre low/mid -> higher. Affirm, hand forward. {{item}} available.", "translatable": true },
            "stayedHigh": { "type": "string", "required": false, "default": "", "title": "Stayed high", "inputType": "TextArea", "validators": [], "help": "High -> stayed high. Neutral. {{item}} available.", "translatable": true },
            "stayedLow":  { "type": "string", "required": false, "default": "", "title": "Stayed low", "inputType": "TextArea", "validators": [], "help": "Low -> stayed low. Honest flag, suggest revisiting. {{item}} available.", "translatable": true },
            "noMovement": { "type": "string", "required": false, "default": "", "title": "No movement (mid)", "inputType": "TextArea", "validators": [], "help": "Mid, no shift. Gentle, points forward. {{item}} available.", "translatable": true },
            "dropped":    { "type": "string", "required": false, "default": "", "title": "Dropped", "inputType": "TextArea", "validators": [], "help": "Fell. Reframe as a more accurate view; suggest revisiting. {{item}} available.", "translatable": true }
          }
        },
        "_summary": {
          "type": "object", "required": false, "title": "Summary variants",
          "properties": {
            "_predominantlyUp": { "type": "string", "required": false, "default": "", "title": "Predominantly up", "inputType": "TextArea", "validators": [], "help": "Most rose/stayed-high. Affirming close, hand forward.", "translatable": true },
            "_mixed":           { "type": "string", "required": false, "default": "", "title": "Mixed", "inputType": "TextArea", "validators": [], "help": "Spread of movement. Normalise downward/unsure items, then hand forward.", "translatable": true },
            "_flatOrLow":       { "type": "string", "required": false, "default": "", "title": "Flat or low", "inputType": "TextArea", "validators": [], "help": "Little movement, mostly low/mid or dropped. Honest, non-defeatist, revisit then forward.", "translatable": true }
          }
        },
        "_standalone": {
          "type": "string", "required": false, "default": "",
          "title": "Standalone (no pre - SA-8)", "inputType": "TextArea", "validators": [],
          "help": "POST shown when no pre ratings exist: a single-reading framing, no delta, pointed forward. {{item}} available.",
          "translatable": true
        },
        "_forward": {
          "type": "object", "required": false, "title": "Forward hand-off (POST)",
          "help": "SA-7. Appended to the summary (and standalone) on every path. One is selected by _hasSummativeFollowing.",
          "properties": {
            "_summative":   { "type": "string", "required": false, "default": "", "title": "If a summative follows", "inputType": "TextArea", "validators": [], "help": "Used when _hasSummativeFollowing is true — points to the assessment ahead.", "translatable": true },
            "_application": { "type": "string", "required": false, "default": "", "title": "If no summative follows", "inputType": "TextArea", "validators": [], "help": "Used when _hasSummativeFollowing is false — points to applying it next.", "translatable": true }
          }
        }
      }
    },
    "_itemFeedbackOverrides": {
      "type": "array", "required": false,
      "title": "Per-item feedback overrides (POST, optional)",
      "help": "OPTIONAL. Bespoke pattern wording for specific items, keyed by item _id. Empty -> the component-level _patterns are used.",
      "items": {
        "type": "object", "required": false,
        "properties": {
          "_itemId":    { "type": "string", "required": true, "default": "", "inputType": "Text", "validators": ["required"], "help": "The item _id this override applies to." },
          "rose":       { "type": "string", "required": false, "default": "", "inputType": "TextArea", "validators": [], "translatable": true },
          "stayedHigh": { "type": "string", "required": false, "default": "", "inputType": "TextArea", "validators": [], "translatable": true },
          "stayedLow":  { "type": "string", "required": false, "default": "", "inputType": "TextArea", "validators": [], "translatable": true },
          "noMovement": { "type": "string", "required": false, "default": "", "inputType": "TextArea", "validators": [], "translatable": true },
          "dropped":    { "type": "string", "required": false, "default": "", "inputType": "TextArea", "validators": [], "translatable": true }
        }
      }
    },
    "_recordInteraction": {
      "type": "boolean", "required": false, "default": true,
      "title": "Record interaction", "inputType": "Checkbox", "validators": [],
      "help": "Record each rating to cmi.interactions (likert type) as a self-report. Enables cohort delta extraction from Moodle."
    },
    "_buttons": {
      "type": "object", "required": false, "title": "Buttons",
      "properties": {
        "_submit": {
          "type": "object", "title": "Submit",
          "properties": {
            "buttonText": { "type": "string", "required": false, "default": "Submit", "inputType": "Text", "validators": [], "translatable": true },
            "ariaLabel":  { "type": "string", "required": false, "default": "", "inputType": "Text", "validators": [], "translatable": true }
          }
        }
      }
    }
  }
}
