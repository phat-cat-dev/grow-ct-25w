{
  "manifest": 1,
  "id": "growLevels",
  "name": "adapt-grow-levels",
  "type": "component",
  "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-grow-levels.git",
  "summary": "Access levels — GROW component.",
  "theme": {
    "styling": "tokenised",
    "less": "less/growLevels.less",
    "tokens": [
      "--accent-ink",
      "--c-negative",
      "--c-neutral",
      "--c-positive",
      "--ink",
      "--ink-soft",
      "--line",
      "--shadow",
      "--surface-1"
    ],
    "fill": {
      "repo": "local:adapt-plugins/themes/adapt-grow-theme",
      "path": "less/_defaults/_grow-tokens.less",
      "note": "Theme supplies the :root token values; dark mode handled there."
    }
  },
  "related": {
    "templates": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "paths": [
        "adapt-grow-levels/blocks/block-levels-full.json"
      ]
    },
    "exemplars": {
      "repo": "ssh://git@ssh.srvr.abbdev.uk/forge-abbdev-uk/adapt-content-templates.git",
      "minimum": 3,
      "paths": [
        "adapt-grow-levels/exemplars/levels-access.json",
        "adapt-grow-levels/exemplars/levels-source-reliability.json",
        "adapt-grow-levels/exemplars/levels-thinking-depth.json"
      ]
    },
    "docs": {
      "repo": "local:adapt-docs/adapt_abbdev",
      "path": "components/adapt-grow-levels.md"
    },
    "components": []
  }
}
