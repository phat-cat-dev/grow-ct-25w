{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$anchor": "growLevels",
  "type": "object",
  "title": "Levels (GROW)",
  "properties": {
    "_component": {
      "type": "string",
      "const": "growLevels",
      "default": "growLevels",
      "isObjectId": true,
      "readOnly": true,
      "title": "Component type"
    },
    "_classes": {
      "type": "string",
      "title": "CSS classes",
      "default": ""
    },
    "body": {
      "type": "string",
      "title": "Lead-in",
      "default": ""
    },
    "instruction": {
      "type": "string",
      "title": "Instruction",
      "default": "Select a level to open it, then open the next."
    },
    "_setCompletionOn": {
      "type": "string",
      "title": "Completion",
      "default": "allOpened",
      "enum": ["allOpened", "inview"]
    },
    "_items": {
      "type": "array",
      "title": "Levels",
      "minItems": 1,
      "items": {
        "type": "object",
        "title": "Level",
        "properties": {
          "title": {
            "type": "string",
            "title": "Level title",
            "default": "",
            "required": true
          },
          "body": {
            "type": "string",
            "title": "What it is / what it allows",
            "default": ""
          },
          "advice": {
            "type": "string",
            "title": "In-practice advice (student-directed)",
            "default": ""
          },
          "_tone": {
            "type": "string",
            "title": "Tone colour",
            "default": "guarded",
            "enum": ["restricted", "guarded", "open", "neutral"]
          }
        },
        "required": ["title"]
      }
    }
  },
  "required": ["_component", "_items"]
}
