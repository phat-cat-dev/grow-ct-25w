{
  "templateId": "course-pack",
  "version": "0.1.0-draft",
  "kind": "user-facing-doc",
  "_comment": "Generated by tools/render-doc.js when the end-of-CRS course spec is produced (gate-redesign-2026-10-06.md, A5). User-facing 'course pack' rollup of the shell design. Section order mirrors the build: ONB -> CXS -> CRS. CXP is out of scope (A5). Field paths map onto the course-spec data object; see course-pack.example.json for the shape.",
  "titleTemplate": "Course pack — {identity.courseName}",
  "intro": "A plain-language summary of how this course is set up. It is generated from the course's design record at the end of the course stage; where this and the record differ, the record wins.",
  "sections": [
    {
      "heading": "About this course",
      "kind": "fields",
      "source": "identity",
      "fields": [
        { "label": "Course", "path": "courseName" },
        { "label": "Theme", "path": "theme" },
        { "label": "Pitch", "path": "pitch" },
        { "label": "Reference (slug)", "path": "slug" }
      ]
    },
    {
      "heading": "Context",
      "kind": "fields",
      "source": "contextShell",
      "note": "Set per subject when a context pack is built. 'none' means not yet set.",
      "empty": "none",
      "fields": [
        { "label": "Institutional context", "path": "institutional" },
        { "label": "Subject context", "path": "subject" },
        { "label": "Qualifiers", "path": "qualifiers" },
        { "label": "Referencing style", "path": "referencing" },
        { "label": "External standards", "path": "externalStandards" }
      ]
    },
    {
      "heading": "What the course covers",
      "kind": "fields",
      "source": "thematicScope",
      "fields": [
        { "label": "Drawn from", "path": "sourceType" },
        { "label": "In scope", "path": "sectionsInScope", "empty": "—" },
        { "label": "Out of scope", "path": "sectionsOutOfScope", "empty": "—" },
        { "label": "Assumes you already can", "path": "priorExperienceAnchor" }
      ]
    },
    {
      "heading": "Level and demand",
      "kind": "fields",
      "source": "thematicScope.tierWindow",
      "fields": [
        { "label": "Goal", "path": "goal" },
        { "label": "Cognitive demand", "path": "cognitiveDemand" },
        { "label": "Task complexity", "path": "taskComplexity" },
        { "label": "Autonomy", "path": "autonomy" },
        { "label": "Voice band", "path": "voiceBand" },
        { "label": "Outcome verbs", "path": "outcomeVerbs" }
      ]
    },
    {
      "heading": "Thematic strands",
      "kind": "list",
      "source": "thematicStrands",
      "itemPath": "label",
      "note": "The streams the course runs in. Each is likely to become a lesson.",
      "empty": "none set"
    },
    {
      "heading": "What you will be able to do",
      "kind": "group",
      "source": "courseOutcomes",
      "note": "The course outcomes, each with how your confidence in it is framed and the questions that check it.",
      "empty": "none set",
      "itemHeading": "{id} — {text}",
      "blocks": [
        { "kind": "prose", "label": "Confidence", "path": "confidenceStatement.text" },
        { "kind": "list", "source": "mcqQuestions", "itemPath": "stem", "empty": "none yet" }
      ]
    },
    {
      "heading": "How the lessons build",
      "kind": "prose",
      "path": "lessonMap.progression",
      "empty": "to be set"
    },
    {
      "heading": "The lessons",
      "kind": "group",
      "source": "lessonMap.lessons",
      "note": "The planned lessons, in sequence.",
      "empty": "none set",
      "itemHeading": "{sequence}. {title}",
      "blocks": [
        { "kind": "prose", "label": "Topic", "path": "topic" },
        { "kind": "prose", "path": "description" },
        { "kind": "list", "label": "By the end of this lesson you will be able to", "source": "outcomes", "itemPath": "text", "empty": "—" }
      ]
    }
  ]
}
