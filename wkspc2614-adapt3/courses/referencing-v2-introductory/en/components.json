  {
    "_id": "referencing-v2-introductory-SUMM-c-05",
    "_parentId": "referencing-v2-introductory-SUMM-b-05",
    "_type": "component",
    "_component": "text",
    "_classes": "",
    "_layout": "full",
    "title": "Assessment introduction",
    "displayTitle": "",
    "body": "<p>This is the test for the whole course. It covers everything you've studied in the lessons, with a set of questions to work through.</p><p>To pass, you need to score at least 70%. You can retake the test if you don't pass first time.</p>",
