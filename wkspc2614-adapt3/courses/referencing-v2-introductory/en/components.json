  {
    "_id": "referencing-v2-introductory-SUMM-c-20",
    "_parentId": "referencing-v2-introductory-SUMM-b-10",
    "_type": "component",
    "_component": "mcq",
    "_classes": "",
    "_layout": "full",
    "title": "",
    "displayTitle": "",
    "body": "<p>Why does academic work name its sources?</p>",
    "instruction": "Choose one option and select Submit.",
    "_pageLevelProgress": {
      "_isEnabled": true,
      "_isCompletionIndicatorEnabled": true
    },
    "ariaQuestion": "Why does academic work name its sources?",
    "_selectable": 1,
    "_attempts": -1,
    "_shouldDisplayAttempts": false,
    "_isRandom": true,
    "_hasItemScoring": false,
    "_questionWeight": 1,
    "_canShowModelAnswer": false,
    "_canShowCorrectness": true,
    "_canShowFeedback": true,
    "_canShowMarking": true,
    "_recordInteraction": true,
    "_isPartOfAssessment": true,
    "_items": [
      {
        "text": "So a reader can judge the quality of a source and trace a claim back to it.",
        "_shouldBeSelected": true,
        "feedback": "Yes. Naming a source lets a reader judge it and follow a claim back to where it came from."
      },
      {
        "text": "So the writer avoids being accused of using too few sources in the work.",
        "_shouldBeSelected": false,
        "feedback": "The point is traceability for the reader, not defending how many sources were used."
      },
      {
        "text": "So the reference list looks longer and more thorough to whoever marks it.",
        "_shouldBeSelected": false,
        "feedback": "A reference list exists for traceability, not to look impressively long."
      },
      {
        "text": "So other students can find extra reading on the same topic later.",
        "_shouldBeSelected": false,
        "feedback": "That can happen, but it is not why academic work names its sources."
      }
    ],
    "_feedback": {
      "title": "",
      "correct": "That's right. Naming a source lets a reader judge the quality of what you used and trace any claim back to its origin.",
      "_incorrect": {
        "notFinal": "Not quite. Think about what a reader can do once they know where a claim came from.",
        "final": ""
      },
      "_partlyCorrect": {
        "notFinal": "",
        "final": ""
      }
    }
  },
  {
    "_id": "referencing-v2-introductory-SUMM-c-25",
    "_parentId": "referencing-v2-introductory-SUMM-b-10",
    "_type": "component",
    "_component": "mcq",
    "_classes": "",
    "_layout": "full",
    "title": "",
    "displayTitle": "",
    "body": "<p>What does a reference need to let a reader trace a claim back to its source?</p>",
    "instruction": "Choose one option and select Submit.",
    "_pageLevelProgress": {
      "_isEnabled": true,
      "_isCompletionIndicatorEnabled": true
    },
    "ariaQuestion": "What does a reference need to let a reader trace a claim?",
    "_selectable": 1,
    "_attempts": -1,
    "_shouldDisplayAttempts": false,
    "_isRandom": true,
    "_hasItemScoring": false,
    "_questionWeight": 1,
    "_canShowModelAnswer": false,
    "_canShowCorrectness": true,
    "_canShowFeedback": true,
    "_canShowMarking": true,
    "_recordInteraction": true,
    "_isPartOfAssessment": true,
    "_items": [
      {
        "text": "Enough detail, in one consistent format, to let a reader locate the exact source used.",
        "_shouldBeSelected": true,
        "feedback": "Yes. Enough detail in one consistent format is what lets a reader find the exact source."
      },
      {
        "text": "A description of the source and where the writer first came across it in general terms.",
        "_shouldBeSelected": false,
        "feedback": "That describes a note to self, not a reference that lets a reader locate the source."
      },
      {
        "text": "A short paraphrase of the source's whole argument, explained in the writer's own words.",
        "_shouldBeSelected": false,
        "feedback": "A paraphrase helps in the text, but a reference needs locating detail, not a summary."
      },
      {
        "text": "The source's title and type, formatted however suits the writer's personal preference.",
        "_shouldBeSelected": false,
        "feedback": "Any format can work, but only if it is applied consistently; personal preference is not the test."
      }
    ],
    "_feedback": {
      "title": "",
      "correct": "That's right. Enough detail, in one consistent format, is what lets a reader locate the exact source.",
      "_incorrect": {
        "notFinal": "Not quite. Think about what a reader actually needs in order to find the source themselves.",
        "final": ""
      },
      "_partlyCorrect": {
        "notFinal": "",
        "final": ""
      }
    }
  },
  {
    "_id": "referencing-v2-introductory-SUMM-c-30",
    "_parentId": "referencing-v2-introductory-SUMM-b-10",
    "_type": "component",
    "_component": "mcq",
    "_classes": "",
    "_layout": "full",
    "title": "",
    "displayTitle": "",
    "body": "<p>What makes a citation inconsistent with a piece of writing's reference list?</p>",
    "instruction": "Choose one option and select Submit.",
    "_pageLevelProgress": {
      "_isEnabled": true,
      "_isCompletionIndicatorEnabled": true
    },
    "ariaQuestion": "What makes a citation inconsistent with the reference list?",
    "_selectable": 1,
    "_attempts": -1,
    "_shouldDisplayAttempts": false,
    "_isRandom": true,
    "_hasItemScoring": false,
    "_questionWeight": 1,
    "_canShowModelAnswer": false,
    "_canShowCorrectness": true,
    "_canShowFeedback": true,
    "_canShowMarking": true,
    "_recordInteraction": true,
    "_isPartOfAssessment": true,
    "_items": [
      {
        "text": "It doesn't match the format or details recorded for that source in the reference list.",
        "_shouldBeSelected": true,
        "feedback": "Yes. A citation is inconsistent when it doesn't match that source's own reference-list entry."
      },
      {
        "text": "It cites a source that the marker would personally disagree with.",
        "_shouldBeSelected": false,
        "feedback": "Inconsistency is about matching format and detail, not about agreeing with a source's content."
      },
      {
        "text": "It appears more times across the essay than other citations do.",
        "_shouldBeSelected": false,
        "feedback": "How often a source is cited doesn't make a citation inconsistent."
      },
      {
        "text": "It sits at the end of a sentence rather than at the start.",
        "_shouldBeSelected": false,
        "feedback": "Where a citation sits in the sentence doesn't make it inconsistent."
      }
    ],
    "_feedback": {
      "title": "",
      "correct": "That's right. A citation is inconsistent when it doesn't match the format and detail recorded for that source elsewhere.",
      "_incorrect": {
        "notFinal": "Not quite. Compare the citation against its own entry in the reference list.",
        "final": ""
      },
      "_partlyCorrect": {
        "notFinal": "",
        "final": ""
      }
    }
  },
  {
