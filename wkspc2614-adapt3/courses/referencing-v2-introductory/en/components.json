        "final": ""
      }
    }
  },
  {
    "_id": "referencing-v2-introductory-SUMM-c-40",
    "_parentId": "referencing-v2-introductory-SUMM-b-10",
    "_type": "component",
    "_component": "mcq",
    "_classes": "",
    "_layout": "full",
    "title": "",
    "displayTitle": "",
    "body": "<p>Why record a source the moment you select it, rather than afterwards?</p>",
    "instruction": "Choose one option and select Submit.",
    "_pageLevelProgress": {
      "_isEnabled": true,
      "_isCompletionIndicatorEnabled": true
    },
    "ariaQuestion": "Why record a source as soon as you select it?",
    "_selectable": 1,
    "_attempts": -1,
    "_shouldDisplayAttempts": false,
    "_isRandom": true,
    "_hasItemScoring": false,
    "_questionWeight": 1,
    "_canShowModelAnswer": false,
    "_canShowCorrectness": true,
    "_canShowFeedback": true,
    "_canShowMarking": true,
    "_recordInteraction": true,
    "_isPartOfAssessment": true,
    "_items": [
      {
        "text": "Because the details are accurate and complete only while the source is still in front of you.",
        "_shouldBeSelected": true,
        "feedback": "Yes. The details are easiest to get right while the source is still in front of you."
      },
      {
        "text": "Because referencing software works faster when sources are logged immediately.",
        "_shouldBeSelected": false,
        "feedback": "Software speed isn't the reason; accuracy while the source is at hand is."
      },
      {
        "text": "Because markers expect to see a timestamp on every source you log.",
        "_shouldBeSelected": false,
        "feedback": "Markers don't check timestamps; the reason is accuracy, not an expectation to meet."
      },
      {
        "text": "Because recording it later would mean citing the source twice by mistake.",
        "_shouldBeSelected": false,
        "feedback": "Logging late risks losing detail, not duplicating the citation itself."
      }
    ],
    "_feedback": {
      "title": "",
      "correct": "That's right. Recording a source while it's in front of you keeps the details accurate and complete.",
      "_incorrect": {
        "notFinal": "Not quite. Think about what you risk losing if you wait until later.",
        "final": ""
      },
      "_partlyCorrect": {
        "notFinal": "",
        "final": ""
      }
    }
  },
