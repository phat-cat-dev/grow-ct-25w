    "_canShowFeedback": true,
    "_canShowMarking": true,
    "_recordInteraction": true,
    "_isPartOfAssessment": true,
    "_items": [
      {
        "text": "It is organised so each entry can be found and checked again later.",
        "_shouldBeSelected": true,
        "feedback": "Yes. An organised log lets you find and check each entry again later."
      },
      {
        "text": "It lists every source in the exact order you happened to read them.",
        "_shouldBeSelected": false,
