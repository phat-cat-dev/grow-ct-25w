    "_layout": "full",
    "title": "",
    "displayTitle": "",
    "body": "<p>Why might you need to explain the sources in your own work to someone unfamiliar with it?</p>",
    "instruction": "Choose one option and select Submit.",
    "_pageLevelProgress": {
      "_isEnabled": true,
      "_isCompletionIndicatorEnabled": true
    },
    "ariaQuestion": "Why explain your sources to someone unfamiliar with the work?",
    "_selectable": 1,
    "_attempts": -1,
    "_shouldDisplayAttempts": false,
    "_isRandom": true,
    "_hasItemScoring": false,
    "_questionWeight": 1,
    "_canShowModelAnswer": false,
    "_canShowCorrectness": true,
    "_canShowFeedback": true,
    "_canShowMarking": true,
    "_recordInteraction": true,
    "_isPartOfAssessment": true,
    "_items": [
      {
        "text": "So they can see why each source was selected and how it supports the work.",
        "_shouldBeSelected": true,
        "feedback": "Yes. Explaining your sources shows why you chose and acknowledged each one."
      },
      {
        "text": "So they can check that you remembered to cite every source you read.",
        "_shouldBeSelected": false,
        "feedback": "That checks completeness, not why a source was selected and acknowledged."
      },
      {
        "text": "So they can judge whether you read enough sources overall for the task.",
        "_shouldBeSelected": false,
        "feedback": "That judges quantity, not the reasoning behind choosing and acknowledging each source."
      },
      {
        "text": "So they can confirm the sources are recent enough to be acceptable.",
        "_shouldBeSelected": false,
        "feedback": "Recency is one possible reason among several, not the purpose of the explanation itself."
      }
    ],
    "_feedback": {
      "title": "",
      "correct": "That's right. Explaining your sources lets someone see why each one was selected and acknowledged.",
      "_incorrect": {
        "notFinal": "Not quite. Think about what the explanation actually reveals about your choices.",
        "final": ""
      },
      "_partlyCorrect": {
