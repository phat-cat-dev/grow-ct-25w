    "title": "",
    "displayTitle": "",
    "body": "<p>What makes a source log useful while you are gathering evidence for a task?</p>",
    "instruction": "Choose one option and select Submit.",
    "_pageLevelProgress": {
      "_isEnabled": true,
      "_isCompletionIndicatorEnabled": true
    },
    "ariaQuestion": "What makes a source log useful while gathering evidence?",
    "_selectable": 1,
