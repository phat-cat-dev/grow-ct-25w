  {
    "_id": "referencing-v2-intermediate-C-POST-c-05",
    "_parentId": "referencing-v2-intermediate-C-POST-b-05",
    "_type": "component",
    "_component": "confidence",
    "_classes": "",
    "_layout": "full",
    "title": "Confidence check",
    "displayTitle": "",
    "body": "",
    "instruction": "Now that you have finished the course, rate each statement again. You will then see how your confidence has changed.",
    "_pageLevelProgress": {
