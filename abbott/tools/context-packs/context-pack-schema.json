{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grow.local/schemas/context-pack-v1.json",
  "title": "GROW Context Pack",
  "description": "A statement plus a stage that is marked up step by step with hand-drawn marks. Three stage types: annotated-prose (inline-commentary), checklist (spot-the-error / evaluation), assembly (sequential-process). Marks reuse the animation-manager draw-on engine and semantic colour roles.",
  "type": "object",
  "required": ["version", "id", "title", "statement", "stage", "steps"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$" },
    "title": { "type": "string", "minLength": 1 },
    "process": { "type": "string", "description": "e.g. marking-feedback, source-evaluation, referencing." },
    "pattern": { "type": "string", "description": "The palette activity pattern it realises, e.g. inline-commentary." },
    "uri": { "type": "string", "description": "SKOS concept URI for this process (skos:Concept / @id)." },
    "altLabel": { "type": "string", "description": "skos:altLabel — an alternative name." },
    "broader": { "type": "string", "description": "skos:broader — parent group URI/slug (e.g. intellectual-depth)." },
    "related": { "type": "array", "items": { "type": "string" }, "description": "skos:related — sibling process ids/URIs." },
    "intent": { "type": "string", "description": "A one-line intent/credit shown under the statement (may contain simple HTML)." },
    "statement": { "type": "string", "description": "The framing sentence shown first, before anything is marked." },
    "advance": { "type": "string", "enum": ["click", "auto"], "default": "click" },
    "autoMs": { "type": "integer", "minimum": 400, "maximum": 20000 },
    "stage": { "$ref": "#/definitions/stage" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } },
    "feedForward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "badge": { "type": "string" },
        "text": { "type": "string" },
        "step": { "type": "integer", "minimum": 0, "description": "Step at which it appears; defaults to the last step." }
      }
    }
  },
  "definitions": {
    "colorRole": { "type": "string", "enum": ["accent", "positive", "negative", "neutral", "comment", "pen", "ink"] },
    "mark": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["underline", "wavy", "oval", "box", "strike", "scribble", "tick", "cross", "question", "exclaim", "star", "caret"], "description": "underline/wavy/oval/box/strike/scribble sit ON a word; tick/cross/question/exclaim/star/caret stamp beside it." },
        "color": { "$ref": "#/definitions/colorRole" }
      }
    },
    "step": {
      "type": "object",
      "required": ["title", "text"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "text": { "type": "string", "description": "What this step teaches — the move and why." }
      }
    },
    "stage": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "segments"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "annotated-prose" },
            "segments": { "type": "array", "items": { "$ref": "#/definitions/segment" } }
          }
        },
        {
          "type": "object",
          "required": ["type", "items"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "checklist" },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "kicker": { "type": "string" }, "title": { "type": "string" }, "meta": { "type": "string" } }
            },
            "items": { "type": "array", "items": { "$ref": "#/definitions/checklistItem" } }
          }
        },
        {
          "type": "object",
          "required": ["type", "parts"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "assembly" },
            "intro": { "type": "string", "description": "Optional rule box above the assembling line (may contain simple HTML)." },
            "parts": { "type": "array", "items": { "$ref": "#/definitions/part" } }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "process" },
            "note": { "type": "string", "description": "Optional note; the cards are built from the pack's steps (SKOS ProcessSteps)." }
          }
        }
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "description": "Always-visible prose text." },
        "id": { "type": "string", "description": "Anchor id — required if this segment carries a note." },
        "step": { "type": "integer", "minimum": 0, "description": "Step at which the mark / note / correction reveals." },
        "mark": { "$ref": "#/definitions/mark" },
        "note": { "type": "string", "description": "A handwritten margin note connected to this word." },
        "noteColor": { "$ref": "#/definitions/colorRole" },
        "correction": { "type": "string", "description": "A handwritten correction placed above the word (use with a strike)." },
        "color": { "$ref": "#/definitions/colorRole" }
      }
    },
    "checklistItem": {
      "type": "object",
      "required": ["label", "step"],
      "additionalProperties": false,
      "properties": {
        "letter": { "type": "string", "description": "A leading letter/badge, e.g. C, R, A." },
        "label": { "type": "string" },
        "question": { "type": "string" },
        "verdict": { "type": "string" },
        "mark": { "$ref": "#/definitions/mark" },
        "step": { "type": "integer", "minimum": 0 }
      }
    },
    "part": {
      "type": "object",
      "required": ["step"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "html": { "type": "string", "description": "Trusted inline HTML for this part (e.g. <i>…</i>); authored content only." },
        "mark": { "$ref": "#/definitions/mark" },
        "step": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
