          "dependencyClass": "constitutive",
          "note": "Name/slug derive from pitch."
        }
      ],
      "response": {
        "mode": "confirm",
        "prompt": "Confirm (or amend) the proposed course name and slug.",
        "destination": "decidedValue"
      },
      "generation": {
        "trigger": "onb-02 and onb-03 closed",
        "produces": "decidedValue.slug + display name",
        "sources": [],
        "parameters": {
          "derive": "name + slug from theme + pitch"
        }
      },
      "consequenceNote": "Agent derives course name + slug from theme + pitch; on confirm, tooling creates the folder and answer-sheet file. No files can be created until answered. (Carries old crs-03_vocabulary shape.)",
      "decidedValueShape": {
        "type": "object",
        "required": [
          "pathwayName",
          "tierName",
          "slug"
