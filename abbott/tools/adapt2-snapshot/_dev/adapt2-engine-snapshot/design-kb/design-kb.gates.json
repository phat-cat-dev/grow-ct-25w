        "mode": "choose",
        "prompt": "Use a theme-preset? (e.g. academic-practice-pathways, or none)",
        "destination": "decidedValue.preset"
      },
      "consequenceNote": "A7-round: optional. A preset bundle (academic-practice-pathways first) scopes onb-02's themes and pre-loads crs-01_sources (assumed-approved, amendable). 'none' = fully custom path.",
      "decidedValueShape": {
        "type": "object",
        "required": [
          "preset"
        ],
        "properties": {
          "preset": {
            "type": "string",
            "description": "A preset id, or 'none'."
          }
        },
        "additionalProperties": false
      },
