        "doc": "docs/authoring/gate-redesign-2026-10-06.md",
        "ref": "A-round"
      },
      "sequence": 0
    },
    {
      "id": "onb-02_course-theme",
      "name": "Course theme",
      "phase": "ONB",
      "kind": "agent+human",
      "hardness": "hard-stop",
      "defaultType": "none",
      "dependsOn": [
        {
          "gate": "onb-01_theme-preset",
          "dependencyClass": "constitutive",
          "note": "The preset scopes which themes are offered."
        }
      ],
      "response": {
        "mode": "choose",
        "prompt": "Select the course theme (preset: a defined pathway; no preset: give a one-sentence topic area for the agent to shape).",
        "destination": "decidedValue.theme"
      },
      "generation": {
        "trigger": "onb-01 closed",
        "produces": "decidedValue.theme",
        "sources": [
          "catalogue/pathways.json",
          "crs-01 source set (no-preset path)"
        ],
        "parameters": {
          "presetPath": "dropdown of the preset's themes",
          "noPresetPath": "user gives a one-sentence topic; agent derives the theme; user confirms"
        }
      },
      "consequenceNote": "Preset chosen -> dropdown of that preset's themes (academic-practice-pathways: the 13, soon 14, pathways). No preset -> user gives a one-sentence topic area, agent turns it into the theme, user confirms.",
      "decidedValueShape": {
        "type": "object",
        "required": [
          "theme"
        ],
        "properties": {
          "theme": {
            "type": "string"
          },
          "themeSource": {
            "enum": [
              "preset",
              "derived"
            ]
          }
        },
        "additionalProperties": false
      },
      "prosePointer": {
        "doc": "docs/authoring/gate-redesign-2026-10-06.md",
        "ref": "A-round"
      },
      "sequence": 1
    },
    {
