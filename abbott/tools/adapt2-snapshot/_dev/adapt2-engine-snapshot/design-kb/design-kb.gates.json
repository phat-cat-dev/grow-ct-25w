          },
          "shortSlug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Short slug <theme(6)>-<tier|level>-<context(6)>, context omitted for the base course, e.g. undlaf-intro (base) / undlaf-intro-psycho (psychology build). Used for export-bundle folder/file names (course-export.js, 9 Oct 2026)."
          }
        }
