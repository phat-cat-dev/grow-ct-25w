      "phase": "ONB",
      "kind": "human",
      "hardness": "hard-stop",
      "defaultType": "none",
      "response": {
        "mode": "answer",
        "prompt": "Set the pitch (tier).",
        "destination": "decidedValue.pitch"
      },
      "consequenceNote": "The tier band. Loosely maps to FHEQ levels (introductory ~L3-low L5; intermediate ~L4-L6; advanced ~L5-L7). no-tier tooling not yet wired. Future per-level targeting lives in cxs-01 (institutional).",
      "decidedValueShape": {
        "type": "object",
        "required": [
          "pitch"
        ],
        "properties": {
          "pitch": {
            "enum": [
              "introductory",
              "intermediate",
              "advanced",
              "no-tier"
            ]
          }
        },
        "additionalProperties": false
      },
      "prosePointer": {
        "doc": "docs/authoring/gate-redesign-2026-10-06.md",
        "ref": "A-round"
      },
      "sequence": 2
    },
    {
      "id": "onb-04_naming",
      "name": "Naming",
      "phase": "ONB",
      "kind": "agent+human",
      "hardness": "hard-stop",
      "defaultType": "none",
      "dependsOn": [
        {
          "gate": "onb-02_course-theme",
